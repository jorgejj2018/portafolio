---
// Propuesta 2 del portafolio: editorial y clara, pensada para clientes y reclutadores.
// Comparte los datos con la versión actual (src/data/perfil.ts).
import '../styles/v2.css';
import Counter from '../components/react/Counter';
import { asset, BASE } from '../lib/base';
import { especializaciones, pedirAcceso, perfil, proyectos, sobreMi, trayectoria } from '../data/perfil';

const [estrella, ...resto] = proyectos;

const nav = [
  { id: 'services', nombre: 'Services' },
  { id: 'work', nombre: 'Work' },
  { id: 'process', nombre: 'Process' },
  { id: 'about', nombre: 'About' },
];

const servicios = [
  {
    titulo: 'Web apps & SaaS',
    texto: 'From idea to a product people use every day: dashboards, multi-tenant SaaS and internal tools.',
    tags: ['React', 'Next.js', 'TypeScript'],
  },
  {
    titulo: 'APIs & integrations',
    texto: 'Reliable backends that connect your systems, payments and partners, built to scale.',
    tags: ['Spring Boot', 'Node.js', 'REST'],
  },
  {
    titulo: 'Cloud & AI agents',
    texto: 'Deploy on Google Cloud and add AI agents that automate real work in your business.',
    tags: ['GCP', 'Vertex AI', 'Agents'],
  },
  {
    titulo: 'Forward deployed engineering',
    texto: 'I join your team, learn the business up close and ship the software it actually needs.',
    tags: ['Fintech', 'Discovery', 'Delivery'],
  },
];

const proceso = [
  { titulo: 'Discover', texto: 'We talk about your business, your users and what success looks like.' },
  { titulo: 'Design', texto: 'I map the solution: screens, data, integrations and a clear plan.' },
  { titulo: 'Build', texto: 'Short iterations with demos, so you see progress every week.' },
  { titulo: 'Launch & grow', texto: 'Deploy to production, measure, and keep improving with you.' },
];

const tecnologias = ['React', 'Next.js', 'TypeScript', 'Node.js', 'Java', 'Spring Boot', 'Google Cloud', 'Vertex AI', 'Firebase', 'Tailwind CSS', 'REST APIs', 'AI agents'];

const credenciales = [
  { titulo: 'Introduction to Vertex AI Studio', fuente: 'Google · 2025' },
  { titulo: 'Python for Data Science and AI', fuente: 'Coursera · 2024' },
  { titulo: 'Software Valley talent award', fuente: 'Medellín mayor’s office · 2020' },
];

const contacto = [
  { texto: 'LinkedIn', url: perfil.enlaces.linkedin },
  { texto: 'GitHub', url: perfil.enlaces.github },
  { texto: 'X', url: perfil.enlaces.x },
];

const title = `${perfil.nombre} · ${perfil.rol}`;
const description = `${perfil.nombre}, ${perfil.rol.toLowerCase()} in ${perfil.ubicacion}. I turn your idea into software that drives your business.`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f3efe7" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={asset('foto-real.webp')} />
    <link rel="icon" type="image/svg+xml" href={asset('favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="font-sans antialiased">
    <!-- Encabezado -->
    <header class="fixed inset-x-0 top-0 z-40 pt-[env(safe-area-inset-top)] transition-colors duration-300" data-v2-header>
      <nav class="gutter mx-auto flex h-16 max-w-7xl items-center justify-between gap-4" aria-label="Main">
        <a href="#top" class="flex min-h-11 items-center gap-3">
          <span class="grid size-9 place-items-center rounded-full bg-ink text-sm font-extrabold text-paper">JQ</span>
          <span class="font-bold tracking-tight">Jorge Quintero</span>
        </a>
        <ul class="hidden items-center gap-8 text-[0.95rem] font-semibold text-muted lg:flex">
          {nav.map((n) => <li><a href={`#${n.id}`} class="py-2 transition-colors hover:text-ink">{n.nombre}</a></li>)}
        </ul>
        <div class="flex items-center gap-2">
          <a href="#contact" class="btn btn-dark btn-sm">Let's talk</a>
          <button
            type="button"
            class="grid size-11 place-items-center rounded-full border border-ink/15 lg:hidden"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="v2-menu"
            data-v2-menu-btn
          >
            <span class="flex w-4 flex-col gap-1.5"><span class="h-0.5 rounded bg-ink"></span><span class="h-0.5 rounded bg-ink"></span></span>
          </button>
        </div>
      </nav>
      <!-- Menú para celular y tablet vertical -->
      <div id="v2-menu" class="gutter hidden border-t border-line bg-paper pb-6 lg:hidden" data-v2-menu>
        <ul class="flex flex-col pt-2">
          {
            [...nav, { id: 'contact', nombre: 'Contact' }].map((n) => (
              <li class="border-b border-line">
                <a href={`#${n.id}`} class="flex min-h-14 items-center justify-between font-serif text-3xl" data-v2-menu-link>
                  {n.nombre} <span class="text-base text-muted">→</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </header>

    <main id="top" class="overflow-x-clip">
      <!-- Portada -->
      <section class="gutter mx-auto grid min-h-svh max-w-7xl items-center gap-10 pt-24 pb-12 lg:grid-cols-[1.2fr_0.8fr] lg:gap-6 lg:pt-20">
        <div>
          <p class="inline-flex items-center gap-2 rounded-full border border-line bg-paper-2 px-3.5 py-1.5 text-[0.8rem] font-semibold text-muted" data-v2-in>
            <span class="size-2 animate-pulse rounded-full bg-emerald-500"></span> Available for new projects · {perfil.ubicacion}
          </p>
          <h1 class="mt-6 font-serif text-[clamp(2.9rem,8.4vw,6.4rem)] leading-[0.98] tracking-[-0.015em]" data-v2-title>
            I turn your <em class="text-olive">idea</em> into software that drives your <em class="text-olive">business.</em>
          </h1>
          <p class="mt-6 max-w-xl text-[1.08rem] leading-relaxed text-muted" data-v2-in>
            I'm Jorge, a <strong class="text-ink">Forward Deployed Engineer in fintech</strong>. I build software, APIs and integrations that scale, with React, Next.js,
            Spring Boot, Google Cloud and AI agents.
          </p>
          <div class="mt-8 flex flex-wrap gap-3" data-v2-in>
            <a href="#contact" class="btn btn-dark">Start a project <span aria-hidden="true">→</span></a>
            <a href="#work" class="btn btn-line">See my work</a>
          </div>
          <dl class="mt-12 grid max-w-lg grid-cols-3 gap-4 border-t border-line pt-6" data-v2-in>
            {
              sobreMi.datos.map((d) => (
                <div>
                  <dt class="sr-only">{d.etiqueta}</dt>
                  <dd class="font-serif text-[2.4rem] leading-none">
                    <Counter client:visible valor={d.valor} sufijo={d.sufijo} />
                  </dd>
                  <dd class="mt-2 text-xs leading-snug text-muted">{d.etiqueta}</dd>
                </div>
              ))
            }
          </dl>
        </div>

        <!-- Arco del banner con el avatar 3D y tarjetas flotantes -->
        <div class="relative mx-auto w-full max-w-[19rem] sm:max-w-[22rem] lg:max-w-[26rem]" data-v2-hero-art>
          <div class="arch absolute inset-x-[6%] top-[14%] bottom-0 bg-sand" data-v2-arch></div>
          <div class="absolute top-[4%] right-[-4%] size-[38%] rounded-full bg-sage" data-v2-sun></div>
          <img
            src={asset('avatar/hero.webp')}
            alt="3D avatar of Jorge Quintero with arms crossed"
            width="587"
            height="1083"
            class="relative mx-auto w-[78%] select-none"
            draggable="false"
            data-v2-avatar
          />
          <p class="absolute top-[30%] left-[-6%] rounded-2xl bg-paper px-4 py-3 text-sm font-bold shadow-xl shadow-ink/10 sm:left-[-14%]" data-v2-float>
            <span class="block font-mono text-[0.68rem] font-normal tracking-wider text-muted uppercase">Role</span>
            Forward Deployed Engineer
          </p>
          <p class="absolute right-[-4%] bottom-[16%] rounded-2xl bg-ink px-4 py-3 text-sm font-bold text-paper shadow-xl shadow-ink/20 sm:right-[-12%]" data-v2-float>
            <span class="block font-mono text-[0.68rem] font-normal tracking-wider text-paper/60 uppercase">Shipping</span>
            Mercatto SaaS · live
          </p>
        </div>
      </section>

      <!-- Cinta de tecnologías -->
      <div class="overflow-hidden border-y border-line bg-paper-2 py-5" aria-label="Technologies">
        <div class="ticker flex w-max">
          {
            [0, 1].map((k) => (
              <ul class="flex shrink-0 items-center" aria-hidden={k === 1 ? 'true' : undefined}>
                {tecnologias.map((t) => (
                  <li class="flex items-center gap-8 pr-8 font-serif text-[1.9rem] whitespace-nowrap italic">
                    {t}
                    <span class="size-2 rounded-full bg-olive" />
                  </li>
                ))}
              </ul>
            ))
          }
        </div>
      </div>

      <!-- Servicios -->
      <section id="services" class="gutter mx-auto max-w-7xl scroll-mt-16 py-24 lg:py-32">
        <div class="grid gap-6 lg:grid-cols-[0.8fr_1.2fr] lg:items-end">
          <div>
            <p class="kicker" data-v2-in>What I do</p>
            <h2 class="mt-4 font-serif text-[clamp(2.4rem,5.5vw,4.2rem)] leading-[1.02]" data-v2-split>How I can help <em>your business</em></h2>
          </div>
          <p class="max-w-xl text-lg leading-relaxed text-muted lg:justify-self-end" data-v2-in>
            Whether you are starting from a sketch or scaling a product already in production, I take care of the whole path from idea to software that works.
          </p>
        </div>
        <ol class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" data-v2-stagger>
          {
            servicios.map((s, i) => (
              <li class="service flex flex-col rounded-3xl border border-line bg-paper-2 p-6 transition-colors hover:bg-sand/60" data-v2-item>
                <span class="service-n grid size-11 place-items-center rounded-full border border-ink/20 font-mono text-sm transition-colors">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <h3 class="mt-10 font-serif text-[1.9rem] leading-tight">{s.titulo}</h3>
                <p class="mt-3 flex-1 leading-relaxed text-muted">{s.texto}</p>
                <ul class="mt-6 flex flex-wrap gap-2">
                  {s.tags.map((t) => (
                    <li class="rounded-full bg-paper px-3 py-1 font-mono text-[0.7rem] text-muted">{t}</li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ol>
      </section>

      <!-- Trabajo: caso destacado y otros proyectos -->
      <section id="work" class="scroll-mt-16 bg-ink py-24 text-paper lg:py-32">
        <div class="gutter mx-auto max-w-7xl">
          <div class="flex flex-wrap items-end justify-between gap-6">
            <div>
              <p class="kicker !text-sage" data-v2-in>Selected work</p>
              <h2 class="mt-4 font-serif text-[clamp(2.4rem,5.5vw,4.2rem)] leading-[1.02]" data-v2-split>Products I have <em>shipped</em></h2>
            </div>
            <a href={perfil.enlaces.github} target="_blank" rel="noopener" class="btn btn-ghost-light btn-sm" data-v2-in>All repositories ↗</a>
          </div>

          {
            estrella && (
              <article class="mt-14 grid items-center gap-10 rounded-[2rem] bg-ink-2 p-5 sm:p-8 lg:grid-cols-[0.9fr_1.1fr] lg:gap-14 lg:p-12" data-v2-in>
                <div>
                  <p class="font-mono text-xs tracking-wider text-sage uppercase">Case study · Live in production</p>
                  <h3 class="mt-3 font-serif text-[clamp(2.4rem,5vw,3.6rem)] leading-none">{estrella.nombre}</h3>
                  <dl class="mt-7 space-y-4 text-[0.98rem] leading-relaxed">
                    <div>
                      <dt class="font-bold">The challenge</dt>
                      <dd class="text-paper/70">Supermarkets and fruit &amp; vegetable stores selling with paper, spreadsheets or tools that don't fit them.</dd>
                    </div>
                    <div>
                      <dt class="font-bold">What I built</dt>
                      <dd class="text-paper/70">{estrella.descripcion}</dd>
                    </div>
                  </dl>
                  <ul class="mt-6 flex flex-wrap gap-2">
                    {estrella.tags.map((t) => (
                      <li class="rounded-full border border-paper/15 px-3 py-1 font-mono text-[0.7rem] text-paper/70">{t}</li>
                    ))}
                  </ul>
                  <div class="mt-8 flex flex-wrap gap-3">
                    {estrella.demo && (
                      <a href={estrella.demo} target="_blank" rel="noopener" class="btn btn-paper">
                        Open the live app ↗
                      </a>
                    )}
                    {estrella.privado ? (
                      <a href={pedirAcceso(estrella.nombre)} class="btn btn-ghost-light">
                        🔒 Request code access
                      </a>
                    ) : (
                      <a href={estrella.repo} target="_blank" rel="noopener" class="btn btn-ghost-light">
                        View code ↗
                      </a>
                    )}
                  </div>
                </div>
                <a
                  href={estrella.demo ?? estrella.repo}
                  target="_blank"
                  rel="noopener"
                  class="group relative block overflow-hidden rounded-2xl border border-paper/10 bg-paper"
                  aria-label={`Open ${estrella.nombre}`}
                  data-v2-shot
                >
                  <span class="flex items-center gap-1.5 border-b border-ink/10 bg-paper-2 px-4 py-2.5">
                    <span class="size-2.5 rounded-full bg-[#ff5f57]" /><span class="size-2.5 rounded-full bg-[#febc2e]" /><span class="size-2.5 rounded-full bg-[#28c840]" />
                    <span class="ml-3 truncate font-mono text-[0.7rem] text-muted">mercattosas.netlify.app</span>
                  </span>
                  <span class="relative block aspect-[16/10] overflow-hidden" data-mini>
                    <iframe
                      src={estrella.demo}
                      title={`${estrella.nombre}, live preview`}
                      loading="lazy"
                      tabindex="-1"
                      class="pointer-events-none absolute top-0 left-0 h-[800px] w-[1280px] origin-top-left"
                      style="transform:scale(var(--s,0.4))"
                      referrerpolicy="no-referrer"
                      sandbox="allow-scripts allow-same-origin"
                    />
                    <span class="absolute inset-0 grid place-items-center bg-ink/0 transition-colors group-hover:bg-ink/35">
                      <span class="btn btn-dark btn-sm translate-y-2 opacity-0 transition group-hover:translate-y-0 group-hover:opacity-100">Open the live app ↗</span>
                    </span>
                  </span>
                </a>
              </article>
            )
          }

          <ul class="mt-6 grid gap-4 md:grid-cols-3" data-v2-stagger>
            {
              resto.map((p) => (
                <li class="flex flex-col rounded-3xl border border-paper/10 p-6" data-v2-item>
                  <div class="flex items-baseline justify-between gap-4">
                    <h3 class="font-serif text-[1.8rem] leading-tight">{p.nombre}</h3>
                    <span class="font-mono text-xs text-paper/50">{p.anio}</span>
                  </div>
                  <p class="mt-3 flex-1 leading-relaxed text-paper/70">{p.descripcion}</p>
                  <p class="mt-4 font-mono text-[0.72rem] text-paper/50">{p.tags.join(' · ')}</p>
                  <div class="mt-6 flex flex-wrap gap-2">
                    {p.privado ? (
                      <a href={pedirAcceso(p.nombre)} class="btn btn-ghost-light btn-sm">
                        🔒 Request code access
                      </a>
                    ) : (
                      <a href={p.repo} target="_blank" rel="noopener" class="btn btn-ghost-light btn-sm">
                        View code ↗
                      </a>
                    )}
                    {p.demo && (
                      <a href={p.demo} target="_blank" rel="noopener" class="btn btn-paper btn-sm">
                        Live demo ↗
                      </a>
                    )}
                  </div>
                </li>
              ))
            }
          </ul>
          <p class="mt-6 max-w-2xl text-sm leading-relaxed text-paper/50">
            Projects with a lock are private repositories because they hold code for real businesses. Request access by email and I will add you.
          </p>
        </div>
      </section>

      <!-- Proceso -->
      <section id="process" class="gutter mx-auto max-w-7xl scroll-mt-16 py-24 lg:py-32">
        <p class="kicker" data-v2-in>How we work together</p>
        <h2 class="mt-4 max-w-3xl font-serif text-[clamp(2.4rem,5.5vw,4.2rem)] leading-[1.02]" data-v2-split>A clear path from <em>idea</em> to <em>production</em></h2>
        <div class="relative mt-16">
          <span class="absolute top-[1.35rem] right-0 left-0 hidden h-px bg-line md:block" aria-hidden="true"></span>
          <span class="absolute top-[1.35rem] right-0 left-0 hidden h-px origin-left bg-ink md:block" style="transform:scaleX(0)" data-v2-process-line aria-hidden="true"></span>
          <ol class="relative grid gap-10 md:grid-cols-4 md:gap-6">
            {
              proceso.map((p, i) => (
                <li class="relative pl-16 md:pl-0" data-v2-step>
                  <span class="absolute top-0 left-0 grid size-11 place-items-center rounded-full border border-ink bg-paper font-mono text-sm md:relative" data-v2-dot>
                    {i + 1}
                  </span>
                  <h3 class="font-serif text-[1.9rem] leading-tight md:mt-6">{p.titulo}</h3>
                  <p class="mt-2 leading-relaxed text-muted">{p.texto}</p>
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <!-- Sobre mí -->
      <section id="about" class="scroll-mt-16 bg-paper-2 py-24 lg:py-32">
        <div class="gutter mx-auto grid max-w-7xl gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
          <div class="lg:sticky lg:top-28 lg:self-start">
            <div class="relative mx-auto w-full max-w-[20rem] lg:mx-0">
              <div class="arch aspect-[4/5] overflow-hidden bg-sage" data-v2-photo>
                <img src={asset('foto-real.webp')} alt="Jorge Quintero" width="560" height="560" loading="eager" class="size-full object-cover object-[50%_30%] scale-[1.35]" />
              </div>
              <img
                src={asset('avatar/busto-sonrisa.webp')}
                alt=""
                width="241"
                height="403"
                loading="eager"
                class="absolute right-[-10%] bottom-[-6%] w-[34%] drop-shadow-xl"
                data-v2-sticker
              />
            </div>
            <p class="mt-8 text-center font-serif text-2xl italic lg:text-left">“Software is how I turn ideas into something real.”</p>
          </div>

          <div>
            <p class="kicker" data-v2-in>About me</p>
            <h2 class="mt-4 font-serif text-[clamp(2.4rem,5.5vw,4.2rem)] leading-[1.02]" data-v2-split>Hi, I'm Jorge. I build <em>with the business</em> in mind.</h2>
            <div class="mt-8 space-y-5 text-[1.05rem] leading-relaxed text-muted">
              {sobreMi.parrafos.map((p) => <p data-v2-in>{p}</p>)}
            </div>

            <h3 class="mt-14 font-mono text-xs tracking-[0.16em] text-olive uppercase">Going deeper on</h3>
            <ul class="mt-4 grid gap-3 sm:grid-cols-3" data-v2-stagger>
              {
                especializaciones.map((e) => (
                  <li data-v2-item>
                    <a
                      href={e.privado ? pedirAcceso(`${e.tecnologia} track`) : e.repo}
                      target={e.privado ? undefined : '_blank'}
                      rel={e.privado ? undefined : 'noopener'}
                      class="flex h-full flex-col rounded-2xl border border-line bg-paper p-5 transition-colors hover:border-ink"
                    >
                      <span class="font-serif text-[1.7rem] leading-none">{e.tecnologia}</span>
                      <span class="mt-2 flex-1 text-sm text-muted">{e.titulo}</span>
                      <span class="mt-4 text-sm font-bold whitespace-nowrap underline decoration-olive decoration-2 underline-offset-4">
                        {e.privado ? 'Request repo access →' : 'Explore the repo →'}
                      </span>
                    </a>
                  </li>
                ))
              }
            </ul>

            <h3 class="mt-14 font-mono text-xs tracking-[0.16em] text-olive uppercase">Journey</h3>
            <ol class="mt-4 border-t border-line">
              {
                [...trayectoria].reverse().map((t) => (
                  <li class="grid gap-1 border-b border-line py-5 sm:grid-cols-[5rem_1fr] sm:gap-6" data-v2-in>
                    <span class="font-mono text-sm text-olive">{t.anio}</span>
                    <div>
                      <p class="font-bold">{t.titulo}</p>
                      <p class="mt-1 text-[0.95rem] leading-relaxed text-muted">{t.texto}</p>
                    </div>
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
      </section>

      <!-- Recomendación y credenciales -->
      <section class="gutter mx-auto max-w-7xl py-24 lg:py-32">
        <div class="grid gap-12 lg:grid-cols-[1.3fr_0.7fr] lg:gap-20">
          <figure data-v2-in>
            <span class="font-serif text-[6rem] leading-[0.5] text-olive" aria-hidden="true">“</span>
            <blockquote class="mt-2 font-serif text-[clamp(1.7rem,3.6vw,2.7rem)] leading-[1.2]">
              Jorge showed a constant willingness to learn, an intense curiosity to pick up new tools on his own and excellent discipline throughout his training.
            </blockquote>
            <figcaption class="mt-6 text-muted">
              <strong class="text-ink">Mateo Soto Londoño</strong> · his mentor at Academia Geek, recommendation on LinkedIn
            </figcaption>
          </figure>
          <div>
            <p class="kicker" data-v2-in>Credentials</p>
            <ul class="mt-5 border-t border-line">
              {
                credenciales.map((c) => (
                  <li class="border-b border-line py-4" data-v2-in>
                    <p class="font-bold">{c.titulo}</p>
                    <p class="text-sm text-muted">{c.fuente}</p>
                  </li>
                ))
              }
            </ul>
            <a href={perfil.enlaces.linkedin} target="_blank" rel="noopener" class="btn btn-line btn-sm mt-6">All 12 certifications on LinkedIn ↗</a>
          </div>
        </div>
      </section>

      <!-- Contacto -->
      <section id="contact" class="gutter scroll-mt-16 pb-6">
        <div class="mx-auto max-w-7xl overflow-hidden rounded-[2rem] bg-ink px-6 py-16 text-paper sm:px-12 lg:px-16 lg:py-24" data-v2-contact>
          <div class="grid items-center gap-12 lg:grid-cols-[1.4fr_0.6fr]">
            <div>
              <p class="kicker !text-sage">Let's work together</p>
