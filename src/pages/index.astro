---
/**
 * Versión nueva: "Rebuilt with every scroll".
 * Una sola nube de partículas 3D (lib/morph.ts) se transforma en cada capítulo:
 * tu foto real, tus avatares, la app de Mercatto y al final tu nombre.
 * La versión anterior sigue en /old.
 */
import Base from '../layouts/Base.astro';
import Counter from '../components/react/Counter';
import { asset, BASE } from '../lib/base';
import { especializaciones, motivoPrivado, pedirAcceso, perfil, proyectos, sobreMi, stack, trayectoria } from '../data/perfil';

const [estrella, ...resto] = proyectos;

// Cada capítulo tiene su figura de partículas (en el mismo orden que en el script de abajo)
const capitulos = [
  { id: 'hello', nombre: 'Hello' },
  { id: 'about', nombre: 'About' },
  { id: 'stack', nombre: 'Stack' },
  { id: 'tracks', nombre: 'Tracks' },
  { id: 'work', nombre: 'Work' },
  { id: 'journey', nombre: 'Journey' },
  { id: 'contact', nombre: 'Contact' },
  { id: 'build', nombre: "Let's build" },
];

const imagenes = {
  foto: asset('foto-real.webp'),
  tresCuartos: asset('avatar/perfil-tres-cuartos.webp'),
  lado: asset('avatar/perfil-lado.webp'),
  mercatto: asset('mercatto.webp'),
  arriba: asset('avatar/busto-mirando-arriba.webp'),
  hero: asset('avatar/hero.webp'),
};

const botones = [
  { texto: 'LinkedIn', url: perfil.enlaces.linkedin },
  { texto: 'GitHub', url: perfil.enlaces.github },
  { texto: 'X', url: perfil.enlaces.x },
];
---

<Base
  title={`${perfil.nombre} · ${perfil.rol}`}
  description={`${perfil.nombre}, ${perfil.rol.toLowerCase()} in ${perfil.ubicacion}. I turn your idea into software that drives your business.`}
>
  <!-- La nube de partículas vive detrás de todo el contenido -->
  <canvas class="fixed inset-0 -z-0 h-svh w-full" data-morph data-imagenes={JSON.stringify(imagenes)} aria-hidden="true"></canvas>
  <div class="morph-veil pointer-events-none fixed inset-0 z-0" aria-hidden="true"></div>

  <!-- Encabezado -->
  <header class="fixed inset-x-0 top-0 z-40 pt-[env(safe-area-inset-top)]">
    <nav class="gutter mx-auto flex h-16 max-w-7xl items-center justify-between gap-3" aria-label="Main">
      <a href="#hello" class="flex min-h-11 items-center gap-3">
        <span class="grid size-9 place-items-center rounded-lg bg-cream text-sm font-extrabold text-shirt">JQ</span>
        <span class="hidden text-[0.95rem] font-bold tracking-tight text-cream sm:inline">Jorge Quintero</span>
      </a>
      <p class="font-mono text-[0.7rem] tracking-[0.14em] text-ice uppercase lg:hidden" aria-live="polite">
        <span data-cap-num>01</span>/<span>{String(capitulos.length).padStart(2, '0')}</span> · <span data-cap-nombre>Hello</span>
      </p>
      <div class="flex items-center gap-2">
        <a href={`${BASE}old/`} class="hidden min-h-11 items-center px-3 text-sm text-cream-dim hover:text-cream md:inline-flex">Old version</a>
        <a href="#contact" class="btn btn-primary">Let's talk</a>
      </div>
    </nav>
    <div class="h-0.5 origin-left bg-accent" style="transform:scaleX(0)" data-barra></div>
  </header>

  <!-- Índice de capítulos (escritorio): se ve dónde estás y se puede saltar -->
  <nav class="fixed top-1/2 right-6 z-30 hidden -translate-y-1/2 lg:block" aria-label="Chapters">
    <ol class="flex flex-col gap-1">
      {
        capitulos.map((c) => (
          <li>
            <a href={`#${c.id}`} class="cap-link group flex min-h-8 items-center justify-end gap-3 text-xs text-cream-dim transition-colors hover:text-cream" data-cap={c.id}>
              <span class="cap-label translate-x-1 opacity-0 transition group-hover:translate-x-0 group-hover:opacity-100">{c.nombre}</span>
              <span class="cap-dot h-px w-4 bg-cream/40 transition-all" />
            </a>
          </li>
        ))
      }
    </ol>
  </nav>

  <main class="relative z-10">
    <!-- 1 · Hola: tu foto real hecha de partículas -->
    <section id="hello" class="escena" data-escena>
      <div class="panel-escena">
        <p class="eyebrow flex flex-wrap items-center gap-x-3 gap-y-1">
          <span class="h-px w-8 bg-accent"></span>{perfil.rol} <span class="text-cream/40">/</span> {perfil.ubicacion}
        </p>
        <h1 class="mt-5 font-display text-[clamp(3.4rem,13vw,7.5rem)] leading-[0.92] text-cream" data-titulo>
          Jorge <em class="text-ice">Quintero</em><span class="text-accent">.</span>
        </h1>
        <p class="mt-6 max-w-lg text-lg leading-relaxed text-cream-dim">
          I turn your idea into software that drives your business: software, APIs and integrations that scale with React, Next.js, Spring Boot, GCP and AI agents.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#work" class="btn btn-light">See my work</a>
          <a href={`mailto:${perfil.enlaces.email}`} class="btn btn-ghost">Email me</a>
        </div>
        <p class="mt-12 flex items-center gap-3 font-mono text-xs text-cream-dim">
          <span class="scroll-hint relative h-9 w-5 rounded-full border border-cream/30"></span>
          Scroll: the same particles rebuild me in every chapter.
        </p>
      </div>
    </section>

    <!-- 2 · Sobre mí: avatar en tres cuartos -->
    <section id="about" class="escena" data-escena>
      <div class="panel-escena">
        <p class="eyebrow">About</p>
        <h2 class="titulo-escena" data-titulo>From layouts to APIs, <em>one project at a time.</em></h2>
        <div class="mt-6 space-y-4 leading-relaxed text-cream-dim">
          {sobreMi.parrafos.slice(0, 2).map((p) => <p>{p}</p>)}
        </div>
        <dl class="mt-8 grid grid-cols-3 gap-4 border-t border-cream/10 pt-6">
          {
            sobreMi.datos.map((d) => (
              <div>
                <dt class="sr-only">{d.etiqueta}</dt>
                <dd class="font-display text-[2.4rem] leading-none text-cream">
                  <Counter client:visible valor={d.valor} sufijo={d.sufijo} />
                </dd>
                <dd class="mt-2 text-xs leading-snug text-cream-dim">{d.etiqueta}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <!-- 3 · Stack: las partículas forman el símbolo de código -->
    <section id="stack" class="escena" data-escena>
      <div class="panel-escena">
        <p class="eyebrow">Stack</p>
        <h2 class="titulo-escena" data-titulo>The tools I use <em>to build.</em></h2>
        <div class="mt-7 space-y-5">
          {
            stack.map((g) => (
              <div>
                <h3 class="font-mono text-xs tracking-[0.14em] text-ice uppercase">{g.grupo}</h3>
                <ul class="mt-3 flex flex-wrap gap-2">
                  {g.items.map((i) => (
                    <li class="rounded-full border border-cream/15 bg-shirt-2/70 px-3 py-1.5 text-sm text-cream">{i}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- 4 · Especializaciones: avatar de perfil -->
    <section id="tracks" class="escena" data-escena>
      <div class="panel-escena">
        <p class="eyebrow">Specializations</p>
        <h2 class="titulo-escena" data-titulo>Three tracks I keep <em>going deeper on.</em></h2>
        <ul class="mt-7 space-y-3">
          {
            especializaciones.map((e) => (
              <li class="rounded-2xl border border-cream/10 bg-shirt-2/80 p-5 backdrop-blur">
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <p class="font-display text-[2rem] leading-none text-cream">{e.tecnologia}</p>
                    <p class="mt-1 text-sm text-cream-dim">{e.titulo}: {e.texto}</p>
                  </div>
                  <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-accent font-mono text-xs font-bold text-white">{e.sigla}</span>
                </div>
                <a
                  href={e.privado ? pedirAcceso(`${e.tecnologia} track`) : e.repo}
                  target={e.privado ? undefined : '_blank'}
                  rel={e.privado ? undefined : 'noopener'}
                  class="btn btn-ghost mt-4"
                >
                  {e.privado ? '🔒 Request repo access' : 'Explore the repo ↗'}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- 5 · Trabajo: la nube se convierte en la pantalla de Mercatto -->
    <section id="work" class="escena" data-escena>
      <div class="panel-escena">
        <p class="eyebrow">Selected work</p>
        <h2 class="titulo-escena" data-titulo>Products I have <em>shipped.</em></h2>
        {
          estrella && (
            <article class="mt-7 rounded-2xl border border-accent/40 bg-shirt-2/85 p-5 backdrop-blur sm:p-6">
              <p class="font-mono text-[0.7rem] tracking-wider text-emerald-400 uppercase">● Live in production</p>
              <h3 class="mt-2 font-display text-[2.4rem] leading-none text-cream">{estrella.nombre}</h3>
              <p class="mt-3 leading-relaxed text-cream-dim">{estrella.descripcion}</p>
              <p class="mt-3 font-mono text-xs text-cream/50">{estrella.tags.join(' · ')}</p>
              <div class="mt-5 flex flex-wrap gap-2">
                {estrella.demo && (
                  <a href={estrella.demo} target="_blank" rel="noopener" class="btn btn-primary">
                    Open the live app ↗
                  </a>
                )}
                <a href={estrella.privado ? pedirAcceso(estrella.nombre) : estrella.repo} class="btn btn-ghost">
                  {estrella.privado ? '🔒 Request code access' : 'View code ↗'}
                </a>
              </div>
            </article>
          )
        }
        <ul class="mt-3 grid gap-3">
          {
            resto.map((p) => (
              <li class="rounded-2xl border border-cream/10 bg-shirt-2/80 p-5 backdrop-blur">
                <div class="flex items-baseline justify-between gap-4">
                  <h3 class="font-display text-[1.7rem] leading-none text-cream">{p.nombre}</h3>
                  <span class="font-mono text-xs text-ice">{p.anio}</span>
                </div>
                <p class="mt-2 text-sm leading-relaxed text-cream-dim">{p.descripcion}</p>
                <a
                  href={p.privado ? pedirAcceso(p.nombre) : p.repo}
                  target={p.privado ? undefined : '_blank'}
                  rel={p.privado ? undefined : 'noopener'}
                  class="btn btn-ghost mt-4"
                >
                  {p.privado ? '🔒 Request code access' : 'View code ↗'}
                </a>
              </li>
            ))
          }
        </ul>
        <p class="mt-4 text-xs leading-relaxed text-cream/50">{motivoPrivado}</p>
      </div>
    </section>

    <!-- 6 · Trayectoria: avatar mirando hacia arriba -->
    <section id="journey" class="escena" data-escena>
      <div class="panel-escena">
        <p class="eyebrow">Journey</p>
        <h2 class="titulo-escena" data-titulo>From my first commit <em>to production.</em></h2>
        <ol class="relative mt-7 border-l border-cream/15 pl-6">
          {
            [...trayectoria].reverse().map((t, i) => (
              <li class="relative pb-7 last:pb-0">
                <span class:list={['absolute top-1.5 left-[-29px] size-2.5 rounded-full border border-accent', i === 0 ? 'bg-accent' : 'bg-shirt']} />
                <p class="font-mono text-sm text-ice">{t.anio}</p>
                <p class="mt-1 font-display text-[1.6rem] leading-tight text-cream">{t.titulo}</p>
                <p class="mt-1 text-sm leading-relaxed text-cream-dim">{t.texto}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- 7 · Contacto: avatar completo con brazos cruzados -->
    <section id="contact" class="escena" data-escena>
      <div class="panel-escena">
        <p class="eyebrow">Contact</p>
        <h2 class="titulo-escena" data-titulo>Have a project in mind? <em>Let's talk.</em></h2>
        <p class="mt-5 text-lg leading-relaxed text-cream-dim">I am open to full-time roles, freelance projects and collaborations. I usually reply within a day.</p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href={`mailto:${perfil.enlaces.email}`} class="btn btn-primary min-h-12 px-6 text-base">✉ Email me</a>
          <a href={perfil.enlaces.upwork} target="_blank" rel="noopener" class="btn btn-light min-h-12 px-6 text-base">Hire me on Upwork ↗</a>
        </div>
        <p class="mt-4 font-mono text-sm break-all text-cream-dim">{perfil.enlaces.email}</p>
      </div>
    </section>

    <!-- 8 · Cierre: las partículas escriben tu nombre -->
    <section id="build" class="escena escena-final" data-escena>
      <div class="panel-escena panel-final">
        <p class="font-mono text-xs text-emerald-400">✓ build complete · deployed to production</p>
        <p class="sr-only">Jorge Quintero</p>
        <div class="mt-5 flex flex-wrap justify-center gap-3">
          <a href={`mailto:${perfil.enlaces.email}`} class="btn btn-primary min-h-12 px-6 text-base">✉ Email me</a>
          <a href={perfil.enlaces.upwork} target="_blank" rel="noopener" class="btn btn-light min-h-12 px-6 text-base">Hire me on Upwork ↗</a>
        </div>
        <ul class="mt-3 flex flex-wrap justify-center gap-2">
          {
            botones.map((b) => (
              <li>
                <a href={b.url} target="_blank" rel="noopener" class="btn btn-ghost">
                  {b.texto} ↗
                </a>
              </li>
            ))
          }
        </ul>
        <footer class="mt-10 flex flex-wrap items-center justify-center gap-x-4 gap-y-2 pb-[env(safe-area-inset-bottom)] font-mono text-xs text-cream/50">
          <span>© {new Date().getFullYear()} {perfil.nombre} · {perfil.ubicacion}</span>
          <a href={`${BASE}old/`} class="underline underline-offset-4 hover:text-cream">See the previous version</a>
        </footer>
      </div>
    </section>
  </main>

  <script>
    import { iniciarPortafolio } from '../lib/morph-page';
    iniciarPortafolio();
  </script>
</Base>
