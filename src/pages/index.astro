---
/**
 * Versión nueva: "Rebuilt with every scroll".
 * Una sola nube de partículas 3D (lib/morph.ts) se transforma en cada capítulo:
 * tu foto real, tus avatares, la app de Mercatto y al final tu nombre.
 * Pensada para empleadores: cada capítulo trae un resumen corto, hay una ficha de 30 segundos
 * y datos estructurados (JSON-LD, resume.json, llms.txt) para herramientas de IA.
 * La versión anterior sigue en /old.
 */
import Base from '../layouts/Base.astro';
import { asset, BASE } from '../lib/base';
import { especializaciones, motivoPrivado, pedirAcceso, perfil, proyectos, sobreMi, stack, trayectoria } from '../data/perfil';

const [estrella, ...resto] = proyectos;
const sitio = new URL(BASE, Astro.site).href;

// Cada capítulo tiene su figura de partículas (mismo orden que en lib/morph-page.ts)
const capitulos = [
  { id: 'hello', nombre: 'Hello' },
  { id: 'about', nombre: 'About' },
  { id: 'stack', nombre: 'Stack' },
  { id: 'tracks', nombre: 'Tracks' },
  { id: 'work', nombre: 'Work' },
  { id: 'journey', nombre: 'Journey' },
  { id: 'contact', nombre: 'Contact' },
  { id: 'build', nombre: "Let's build" },
];

// Preguntas que un reclutador haría; cada una lleva a su capítulo
const preguntas = [
  { texto: 'What have you shipped?', id: 'work' },
  { texto: "What's your stack?", id: 'stack' },
  { texto: 'Where have you worked?', id: 'journey' },
  { texto: 'How do we start?', id: 'contact' },
];

// Lo que más uso hoy va destacado; el resto del stack va más discreto
const principal = ['React', 'Next.js', 'TypeScript', 'Java', 'Spring Boot', 'Google Cloud (GCP)', 'AI agents'];

const imagenes = {
  foto: asset('foto-real.webp'),
  tresCuartos: asset('avatar/perfil-tres-cuartos.webp'),
  lado: asset('avatar/perfil-lado.webp'),
  mercatto: asset('mercatto.webp'),
  arriba: asset('avatar/busto-mirando-arriba.webp'),
  hero: asset('avatar/hero.webp'),
};

const redes = [
  { texto: 'LinkedIn', url: perfil.enlaces.linkedin },
  { texto: 'GitHub', url: perfil.enlaces.github },
  { texto: 'X', url: perfil.enlaces.x },
];

const resumen = 'Forward Deployed Engineer in fintech with 7+ years building web products. I turn ideas into software, APIs and integrations that scale.';

// Ficha para copiar y pegar (en un ATS, un correo o un chat con IA)
const fichaTexto = [
  `${perfil.nombre} · Forward Deployed Engineer (fintech) · ${perfil.ubicacion}`,
  resumen,
  `Core stack: ${principal.join(', ')}.`,
  `Highlight: ${estrella?.nombre}, a sales SaaS for supermarkets and fruit & vegetable stores, live in production.`,
  `Experience: ${[...trayectoria].reverse().map((t) => `${t.anio} ${t.titulo}`).join('; ')}.`,
  `Email: ${perfil.enlaces.email} · LinkedIn: ${perfil.enlaces.linkedin} · GitHub: ${perfil.enlaces.github} · Upwork: ${perfil.enlaces.upwork}`,
  `Portfolio: ${sitio}`,
].join('\n');

// Datos estructurados (schema.org) para buscadores y herramientas de IA de reclutamiento
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: perfil.nombre,
  jobTitle: 'Forward Deployed Engineer',
  description: resumen,
  email: `mailto:${perfil.enlaces.email}`,
  url: sitio,
  image: new URL(asset('foto-real.webp'), Astro.site).href,
  address: { '@type': 'PostalAddress', addressLocality: 'Medellín', addressCountry: 'CO' },
  knowsAbout: stack.flatMap((g) => g.items),
  sameAs: [perfil.enlaces.linkedin, perfil.enlaces.github, perfil.enlaces.x, perfil.enlaces.upwork],
  subjectOf: { '@type': 'DigitalDocument', name: 'Résumé (JSON Resume)', url: new URL(asset('resume.json'), Astro.site).href },
};
---

<Base title={`${perfil.nombre} · Forward Deployed Engineer · Fintech`} description={`${perfil.nombre}, ${resumen}`}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <link rel="alternate" type="application/json" href={asset('resume.json')} title="Résumé (JSON Resume)" />

  <!-- La nube de partículas vive detrás de todo el contenido -->
  <canvas class="fixed inset-0 z-0 h-svh w-full" data-morph data-imagenes={JSON.stringify(imagenes)} aria-hidden="true"></canvas>
  <div class="morph-veil pointer-events-none fixed inset-0 z-0" aria-hidden="true"></div>
  <div class="morph-loader pointer-events-none fixed inset-x-0 bottom-8 z-20 text-center font-mono text-xs text-cream-dim" data-loader aria-hidden="true">
    assembling<span data-loader-pct> 0%</span>
  </div>

  <!-- Encabezado -->
  <header class="fixed inset-x-0 top-0 z-40 border-b border-cream/5 bg-shirt/70 pt-[env(safe-area-inset-top)] backdrop-blur-md">
    <nav class="gutter mx-auto flex h-16 max-w-7xl items-center justify-between gap-3" aria-label="Main">
      <a href="#hello" class="flex min-h-11 shrink-0 items-center gap-3">
        <span class="grid size-9 place-items-center rounded-lg bg-cream text-sm font-extrabold text-shirt">JQ</span>
        <span class="hidden text-[0.95rem] font-bold tracking-tight text-cream md:inline">Jorge Quintero</span>
      </a>
      <p class="min-w-0 truncate font-mono text-[0.68rem] tracking-[0.12em] text-ice uppercase lg:hidden" aria-live="polite">
        <span data-cap-num>01</span>/{String(capitulos.length).padStart(2, '0')} · <span data-cap-nombre>Hello</span>
      </p>
      <div class="flex shrink-0 items-center gap-2">
        <a href={`${BASE}old/`} class="hidden min-h-11 items-center px-2 text-sm text-cream-dim hover:text-cream xl:inline-flex">Old version</a>
        <button type="button" class="btn btn-ghost" data-abrir-ficha>
          <span class="sm:hidden">Profile</span><span class="hidden sm:inline">30-second profile</span>
        </button>
        <a href="#contact" class="btn btn-primary hidden sm:inline-flex">Let's talk</a>
      </div>
    </nav>
    <div class="h-0.5 origin-left bg-accent" style="transform:scaleX(0)" data-barra></div>
  </header>

  <!-- Índice de capítulos (escritorio) -->
  <nav class="fixed top-1/2 right-5 z-30 hidden -translate-y-1/2 lg:block" aria-label="Chapters">
    <ol class="flex flex-col gap-0.5">
      {
        capitulos.map((c, i) => (
          <li>
            <a href={`#${c.id}`} class="cap-link flex min-h-8 items-center justify-end gap-3 text-xs text-cream-dim transition-colors hover:text-cream" data-cap={c.id}>
              <span class="cap-label">{c.nombre}</span>
              <span class="font-mono text-[0.65rem] text-cream/35">{String(i + 1).padStart(2, '0')}</span>
              <span class="cap-dot h-px w-4 bg-cream/40 transition-all" />
            </a>
          </li>
        ))
      }
    </ol>
  </nav>

  <main class="relative z-10">
    <!-- 1 · Hola: la foto real hecha de partículas -->
    <section id="hello" class="escena escena-hola" data-escena>
      <div class="panel-escena">
        <p class="eyebrow">Forward Deployed Engineer · Fintech · {perfil.ubicacion}</p>
        <h1 class="mt-4 font-display text-[clamp(3.3rem,12.5vw,7.2rem)] leading-[0.9] text-cream" data-titulo>
          Jorge <em>Quintero</em><span class="text-accent">.</span>
        </h1>
        <p class="mt-5 max-w-lg text-[1.1rem] leading-relaxed text-cream-dim sm:text-lg">
          I turn your idea into <span class="text-cream">software that drives your business</span>: products, APIs and integrations that scale.
        </p>
        <div class="mt-7 flex flex-wrap gap-2.5">
          <a href="#contact" class="btn btn-primary min-h-12 px-6">Let's talk</a>
          <button type="button" class="btn btn-light min-h-12 px-6" data-abrir-ficha>30-second profile</button>
        </div>

        <!-- Preguntas rápidas: navegación como una conversación -->
        <div class="mt-9">
          <p class="font-mono text-[0.7rem] tracking-[0.14em] text-cream/50 uppercase">Ask me</p>
          <ul class="mt-3 flex flex-wrap gap-2">
            {
              preguntas.map((p) => (
                <li>
                  <a href={`#${p.id}`} class="pregunta">
                    {p.texto} <span aria-hidden="true">→</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <p class="mt-8 flex items-center gap-3 font-mono text-[0.7rem] text-cream-dim">
          <span class="scroll-hint relative h-8 w-[1.15rem] shrink-0 rounded-full border border-cream/30"></span>
          Scroll · the same particles rebuild me in every chapter
        </p>
      </div>
    </section>

    <!-- 2 · Sobre mí -->
    <section id="about" class="escena" data-escena>
      <div class="panel-escena">
        <p class="cap-head"><span>02</span> About</p>
        <h2 class="titulo-escena" data-titulo>From layouts to APIs, <em>one project at a time.</em></h2>
        <p class="tldr"><b>In short</b>{resumen}</p>
        <div class="mt-5 space-y-4 leading-relaxed text-cream-dim">
          {sobreMi.parrafos.slice(0, 2).map((p) => <p>{p}</p>)}
        </div>
        <dl class="mt-7 grid grid-cols-3 gap-3 border-t border-cream/10 pt-5">
          {
            sobreMi.datos.map((d) => (
              <div>
                <dt class="sr-only">{d.etiqueta}</dt>
                <dd class="font-display text-[2.3rem] leading-none text-cream">
                  {d.valor}
                  {d.sufijo}
                </dd>
                <dd class="mt-1.5 text-[0.72rem] leading-snug text-cream-dim">{d.etiqueta}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <!-- 3 · Stack -->
    <section id="stack" class="escena" data-escena>
      <div class="panel-escena">
        <p class="cap-head"><span>03</span> Stack</p>
        <h2 class="titulo-escena" data-titulo>The tools I use <em>to build.</em></h2>
        <p class="tldr"><b>In short</b>Full stack: React and Next.js on the front, Java, Spring Boot and Node.js on the back, Google Cloud and AI agents in production.</p>
        <p class="mt-6 font-mono text-[0.7rem] tracking-[0.14em] text-ice uppercase">Daily drivers</p>
        <ul class="mt-3 flex flex-wrap gap-2">
          {principal.map((i) => <li class="rounded-full bg-cream px-3.5 py-1.5 text-sm font-semibold text-shirt">{i}</li>)}
        </ul>
        <div class="mt-6 grid gap-4 sm:grid-cols-3">
          {
            stack.map((g) => (
              <div>
                <h3 class="font-mono text-[0.7rem] tracking-[0.14em] text-ice uppercase">{g.grupo}</h3>
                <ul class="mt-2 space-y-1 text-sm text-cream-dim">
                  {g.items
                    .filter((i) => !principal.includes(i))
                    .map((i) => (
                      <li>{i}</li>
                    ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- 4 · Especializaciones -->
    <section id="tracks" class="escena" data-escena>
      <div class="panel-escena">
        <p class="cap-head"><span>04</span> Tracks</p>
        <h2 class="titulo-escena" data-titulo>Three tracks I keep <em>going deeper on.</em></h2>
        <p class="tldr"><b>In short</b>Each track is a private repository where I practice and document. Ask for access and I will add you.</p>
        <ul class="mt-6 space-y-2.5">
          {
            especializaciones.map((e) => (
              <li class="tarjeta flex flex-wrap items-center gap-x-4 gap-y-3">
                <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-accent font-mono text-xs font-bold text-white">{e.sigla}</span>
                <div class="min-w-[7.5rem] flex-1">
                  <p class="font-display text-[1.6rem] leading-none text-cream">{e.tecnologia}</p>
                  <p class="mt-1 text-sm text-cream-dim">{e.titulo}</p>
                </div>
                <a
                  href={e.privado ? pedirAcceso(`${e.tecnologia} track`) : e.repo}
                  target={e.privado ? undefined : '_blank'}
                  rel={e.privado ? undefined : 'noopener'}
                  class="btn btn-ghost shrink-0"
                  aria-label={`${e.privado ? 'Request access to' : 'Open'} the ${e.tecnologia} repository`}
                >
                  {e.privado ? '🔒 Access' : 'Open ↗'}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- 5 · Trabajo -->
    <section id="work" class="escena" data-escena>
      <div class="panel-escena">
        <p class="cap-head"><span>05</span> Work</p>
        <h2 class="titulo-escena" data-titulo>Products I have <em>shipped.</em></h2>
        {
          estrella && (
            <article class="tarjeta mt-6 border-accent/40">
              <img src={asset('mercatto.webp')} alt="Mercatto SaaS sign-in screen" width="960" height="600" loading="lazy" class="aspect-[16/10] w-full rounded-xl object-cover object-top" />
              <p class="mt-4 font-mono text-[0.68rem] tracking-wider text-emerald-400 uppercase">● Live in production</p>
              <h3 class="mt-1 font-display text-[2.2rem] leading-none text-cream">{estrella.nombre}</h3>
              <p class="mt-2 text-[0.95rem] leading-relaxed text-cream-dim">{estrella.descripcion}</p>
              <p class="mt-2 font-mono text-[0.7rem] text-cream/50">{estrella.tags.join(' · ')}</p>
              <div class="mt-4 flex flex-wrap gap-2">
                {estrella.demo && (
                  <a href={estrella.demo} target="_blank" rel="noopener" class="btn btn-primary">
                    Open the live app ↗
                  </a>
                )}
                <a href={estrella.privado ? pedirAcceso(estrella.nombre) : estrella.repo} class="btn btn-ghost">
                  {estrella.privado ? '🔒 Request code access' : 'View code ↗'}
                </a>
              </div>
            </article>
          )
        }
        <ul class="mt-2.5 space-y-2.5">
          {
            resto.map((p) => (
              <li class="tarjeta">
                <div class="flex items-start gap-3">
                  <div class="min-w-0 flex-1">
                    <h3 class="font-display text-[1.55rem] leading-none text-cream">
                      {p.nombre} <span class="ml-1 font-mono text-xs text-ice">{p.anio}</span>
                    </h3>
                    <p class="mt-1.5 text-sm leading-relaxed text-cream-dim">{p.descripcion}</p>
                  </div>
                  <a
                    href={p.privado ? pedirAcceso(p.nombre) : p.repo}
                    target={p.privado ? undefined : '_blank'}
                    rel={p.privado ? undefined : 'noopener'}
                    class="btn btn-ghost shrink-0"
                    aria-label={`${p.privado ? 'Request code access for' : 'View the code of'} ${p.nombre}`}
                  >
                    {p.privado ? '🔒 Access' : 'Code ↗'}
                  </a>
                </div>
              </li>
            ))
          }
        </ul>
        <p class="mt-3 text-xs leading-relaxed text-cream/50">{motivoPrivado}</p>
      </div>
    </section>

    <!-- 6 · Trayectoria -->
    <section id="journey" class="escena" data-escena>
      <div class="panel-escena">
        <p class="cap-head"><span>06</span> Journey</p>
        <h2 class="titulo-escena" data-titulo>From my first commit <em>to production.</em></h2>
        <ol class="relative mt-6 border-l border-cream/15 pl-6">
          {
            [...trayectoria].reverse().map((t, i) => (
              <li class="relative pb-5 last:pb-0">
                <span class:list={['absolute top-1.5 left-[-29px] size-2.5 rounded-full border border-accent', i === 0 ? 'bg-accent' : 'bg-shirt']} />
                <p class="font-mono text-xs text-ice">{t.anio}</p>
                <p class="mt-0.5 font-display text-[1.45rem] leading-tight text-cream">{t.titulo}</p>
                <p class="mt-0.5 text-sm leading-relaxed text-cream-dim">{t.texto}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- 7 · Contacto: invitación neutral -->
    <section id="contact" class="escena" data-escena>
      <div class="panel-escena">
        <p class="cap-head"><span>07</span> Contact</p>
        <h2 class="titulo-escena" data-titulo>An idea, a product or a team to build with? <em>Let's talk.</em></h2>
        <p class="tldr"><b>In short</b>Email is the fastest way to reach me. I usually reply within a day.</p>
        <div class="mt-6 flex flex-wrap gap-2.5">
          <a href={`mailto:${perfil.enlaces.email}`} class="btn btn-primary min-h-12 px-6">Email me</a>
          <button type="button" class="btn btn-light min-h-12 px-6" data-copiar={perfil.enlaces.email}>Copy email</button>
          <a href={perfil.enlaces.upwork} target="_blank" rel="noopener" class="btn btn-ghost min-h-12 px-6">Upwork ↗</a>
        </div>
        <p class="mt-4 font-mono text-sm break-all text-cream-dim">{perfil.enlaces.email}</p>
      </div>
    </section>

    <!-- 8 · Cierre: las partículas escriben tu nombre -->
    <section id="build" class="escena escena-final" data-escena>
      <div class="panel-escena panel-final">
        <p class="font-mono text-xs text-emerald-400">✓ build complete · deployed to production</p>
        <p class="sr-only">Jorge Quintero</p>
        <div class="mt-5 flex flex-wrap justify-center gap-2.5">
          <a href={`mailto:${perfil.enlaces.email}`} class="btn btn-primary min-h-12 px-6">Email me</a>
          <button type="button" class="btn btn-light min-h-12 px-6" data-abrir-ficha>30-second profile</button>
        </div>
        <ul class="mt-2.5 flex flex-wrap justify-center gap-2">
          {
            redes.map((b) => (
              <li>
                <a href={b.url} target="_blank" rel="noopener" class="btn btn-ghost">
                  {b.texto} ↗
                </a>
              </li>
            ))
          }
        </ul>
        <footer class="mt-10 flex flex-wrap items-center justify-center gap-x-4 gap-y-2 pb-[env(safe-area-inset-bottom)] font-mono text-xs text-cream/50">
          <span>© {new Date().getFullYear()} {perfil.nombre} · {perfil.ubicacion}</span>
          <a href={asset('resume.json')} class="underline underline-offset-4 hover:text-cream">resume.json</a>
          <a href={`${BASE}old/`} class="underline underline-offset-4 hover:text-cream">Previous version</a>
        </footer>
      </div>
    </section>
  </main>

  <!-- Ficha de 30 segundos: todo el perfil en una vista, para quien tiene prisa -->
  <dialog class="ficha" data-ficha aria-labelledby="ficha-titulo">
    <div class="flex items-start gap-4">
      <img src={asset('foto-real.webp')} alt="" width="560" height="560" class="size-16 shrink-0 rounded-full ring-2 ring-accent/60" />
      <div class="min-w-0 flex-1">
        <p id="ficha-titulo" class="font-display text-[2rem] leading-none text-cream">{perfil.nombre}</p>
        <p class="mt-1 text-sm text-cream-dim">Forward Deployed Engineer · Fintech · {perfil.ubicacion}</p>
      </div>
      <button type="button" class="grid size-11 shrink-0 place-items-center rounded-full border border-cream/15 text-cream" aria-label="Close" data-cerrar-ficha>✕</button>
    </div>
    <p class="mt-5 leading-relaxed text-cream">{resumen}</p>
    <div class="mt-5 grid gap-5 sm:grid-cols-2">
      <div>
        <p class="ficha-label">Core stack</p>
        <ul class="mt-2 flex flex-wrap gap-1.5">
          {principal.map((i) => <li class="rounded-full bg-cream/10 px-2.5 py-1 text-xs text-cream">{i}</li>)}
        </ul>
        <p class="ficha-label mt-5">Highlights</p>
        <ul class="mt-2 space-y-1.5 text-sm text-cream-dim">
          <li>▸ 7+ years building web products</li>
          <li>▸ Fintech product and API integrations</li>
          <li>▸ {estrella?.nombre}: own SaaS live in production</li>
          <li>▸ Google certification in Vertex AI Studio</li>
        </ul>
      </div>
      <div>
        <p class="ficha-label">Experience</p>
        <ol class="mt-2 space-y-1.5 text-sm">
          {
            [...trayectoria].reverse().map((t) => (
              <li class="flex gap-3">
                <span class="w-10 shrink-0 font-mono text-xs text-ice">{t.anio}</span>
                <span class="text-cream-dim">{t.titulo}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
    <div class="mt-6 flex flex-wrap gap-2 border-t border-cream/10 pt-5">
      <a href={`mailto:${perfil.enlaces.email}`} class="btn btn-primary">Email me</a>
      <button type="button" class="btn btn-light" data-copiar={fichaTexto}>Copy profile summary</button>
      <a href={perfil.enlaces.linkedin} target="_blank" rel="noopener" class="btn btn-ghost">LinkedIn ↗</a>
      <a href={perfil.enlaces.upwork} target="_blank" rel="noopener" class="btn btn-ghost">Upwork ↗</a>
    </div>
  </dialog>

  <p class="toast" role="status" aria-live="polite" data-toast></p>

  <script>
    import { iniciarPortafolio } from '../lib/morph-page';
    iniciarPortafolio();
  </script>
</Base>
