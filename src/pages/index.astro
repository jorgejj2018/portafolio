---
/**
 * Versión "Inmersión" (inspirada en el ritmo de plastic-ocean.com).
 * El scroll es un descenso: de la superficie (la idea) a lo profundo (producción).
 * El avatar es el protagonista: flota, gira y cambia de pose mientras bajas;
 * las cifras aparecen en tarjetas de vidrio y los años se cuentan con el scroll.
 * La versión de partículas sigue en /particles y la primera en /old.
 */
import Base from '../layouts/Base.astro';
import '../styles/dive.css';
import { asset, BASE } from '../lib/base';
import { datosEstructurados, especializaciones, motivoPrivado, pedirAcceso, perfil, proyectos, stack, trayectoria } from '../data/perfil';

const [estrella, ...resto] = proyectos;
const urlSitio = Astro.site ? new URL(BASE, Astro.site).href : BASE;
const jsonLd = JSON.stringify(datosEstructurados(urlSitio));

const cifras = [
  { valor: 7, sufijo: '+', unidad: 'yrs', texto: 'building products for the web' },
  { valor: 40, sufijo: '+', unidad: 'repos', texto: 'public and private on GitHub' },
  { valor: 12, sufijo: '', unidad: 'certs', texto: 'licenses and certifications, including Google Vertex AI' },
  { valor: 1, sufijo: '', unidad: 'SaaS', texto: 'of my own, live in production' },
];

// Burbujas que suben en la escena del stack
const burbujas = ['React', 'Next.js', 'TypeScript', 'Java', 'Spring Boot', 'Node.js', 'GCP', 'Vertex AI', 'AI agents', 'REST', 'Firebase', 'Tailwind'];

const historia = [...trayectoria];
const menu = [
  { id: 'surface', nombre: 'Surface' },
  { id: 'numbers', nombre: 'In numbers' },
  { id: 'stack', nombre: 'Beneath' },
  { id: 'work', nombre: 'Work' },
  { id: 'journey', nombre: 'Journey' },
  { id: 'contact', nombre: 'Contact' },
];

const poses = [
  { id: 'hero', src: asset('avatar/hero.webp'), w: 587, h: 1083 },
  { id: 'tres', src: asset('avatar/perfil-tres-cuartos.webp'), w: 187, h: 362 },
  { id: 'lado', src: asset('avatar/perfil-lado.webp'), w: 132, h: 363 },
  { id: 'arriba', src: asset('avatar/busto-mirando-arriba.webp'), w: 265, h: 401 },
];
---

<Base title={`${perfil.nombre} · ${perfil.rol}`} description={`${perfil.nombre}, ${perfil.rol.toLowerCase()} in ${perfil.ubicacion}. ${perfil.lema}`}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={jsonLd} />
    <link rel="alternate" type="application/json" href={`${BASE}profile.json`} title="Machine-readable profile" />
    <link rel="alternate" type="text/plain" href={`${BASE}llms.txt`} title="Profile for AI assistants" />
  </Fragment>

  <!-- Escenario fijo: agua, luz, burbujas y el avatar protagonista -->
  <div class="dive-stage" aria-hidden="true">
    <div class="dive-sky" data-sky></div>
    <div class="dive-water" data-water></div>
    <div class="dive-rays" data-rays></div>
    <div class="dive-surface" data-surface>
      <svg viewBox="0 0 1440 60" preserveAspectRatio="none"><path d="M0 30 Q 180 10 360 30 T 720 30 T 1080 30 T 1440 30 V60 H0Z" /></svg>
    </div>
    <div class="dive-bubbles" data-bubbles data-palabras={JSON.stringify(burbujas)}></div>
    <div class="dive-hero" data-avatar>
      {poses.map((p, i) => <img src={p.src} alt="" width={p.w} height={p.h} class="dive-pose" data-pose={p.id} style={i === 0 ? '' : 'opacity:0'} draggable="false" />)}
    </div>
    <img src={asset('mercatto.webp')} alt="" width="960" height="600" class="dive-object" data-object />
  </div>

  <!-- Encabezado mínimo, como la referencia -->
  <header class="fixed inset-x-0 top-0 z-40 bg-gradient-to-b from-[#0a101c]/75 to-transparent pt-[env(safe-area-inset-top)]">
    <nav class="dive-gutter flex h-16 items-center justify-between gap-3" aria-label="Main">
      <a href="#surface" class="flex min-h-11 items-center gap-2.5 text-cream">
        <span class="grid size-9 place-items-center rounded-lg bg-cream text-sm font-extrabold text-shirt">JQ</span>
        <span class="hidden text-sm font-semibold sm:inline">Jorge Quintero</span>
      </a>
      <div class="flex items-center gap-2">
        <a href="#contact" class="btn btn-primary hidden sm:inline-flex">Let's talk</a>
        <button type="button" class="dive-pill" data-menu-btn aria-expanded="false" aria-controls="dive-menu">Menu</button>
      </div>
    </nav>
  </header>

  <!-- Menú a pantalla completa -->
  <div id="dive-menu" class="dive-menu" data-menu hidden>
    <nav class="dive-gutter flex min-h-svh flex-col justify-center pt-20 pb-10" aria-label="Sections">
      <ol class="space-y-1">
        {
          menu.map((m, i) => (
            <li>
              <a href={`#${m.id}`} class="dive-menu-link" data-menu-link>
                <span class="font-mono text-xs text-ice">{String(i + 1).padStart(2, '0')}</span>
                {m.nombre}
              </a>
            </li>
          ))
        }
      </ol>
      <div class="mt-10 flex flex-wrap gap-2">
        <a href={`mailto:${perfil.enlaces.email}`} class="btn btn-primary">Email me</a>
        <a href={perfil.enlaces.linkedin} target="_blank" rel="noopener" class="btn btn-ghost">LinkedIn ↗</a>
        <a href={`${BASE}particles/`} class="btn btn-ghost">Particles version</a>
      </div>
    </nav>
  </div>

  <main class="relative z-10">
    <!-- 1 · Superficie -->
    <section id="surface" class="dive-scene dive-hero-scene">
      <h1 class="dive-title" data-hero-title>Jorge Quintero</h1>
      <p class="dive-hero-lead">Ideas don't disappear.<br />They ship.</p>
      <p class="dive-hero-scroll">Scroll down to dive in</p>
      <p class="dive-hero-note">{perfil.rol}<br />{perfil.ubicacion}</p>
    </section>

    <!-- 2 · Frases centradas mientras el avatar se hunde y gira -->
    <section class="dive-scene dive-center">
      <p class="dive-phrase" data-phrase>Good software rarely draws attention.</p>
    </section>
    <section class="dive-scene dive-center">
      <p class="dive-phrase" data-phrase>It's often seen as <em>just code.</em></p>
    </section>
    <section class="dive-scene dive-center">
      <p class="dive-phrase" data-phrase>Behind it, there is <em>someone who builds it.</em></p>
    </section>

    <!-- 3 · Cifras en tarjetas de vidrio -->
    <section id="numbers" class="dive-scene dive-numbers">
      <h2 class="sr-only">Jorge in numbers</h2>
      {
        cifras.map((c, i) => (
          <div class:list={['dive-card', `dive-card-${i}`]} data-card>
            <p class="dive-card-num">
              <span data-count={c.valor}>{c.valor}</span>
              {c.sufijo}
              <small>{c.unidad}</small>
            </p>
            <p class="dive-card-text">{c.texto}</p>
          </div>
        ))
      }
    </section>

    <!-- 4 · Lo que hay debajo: el stack -->
    <section id="stack" class="dive-scene dive-split">
      <div class="dive-panel" data-panel>
        <p class="dive-kicker">What lies beneath</p>
        <h2 class="dive-h2">The stack that keeps <em>it afloat.</em></h2>
        <div class="mt-6 space-y-5">
          {
            stack.map((g) => (
              <div>
                <h3 class="dive-kicker !text-cream/60">{g.grupo}</h3>
                <ul class="mt-2.5 flex flex-wrap gap-1.5">
                  {g.items.map((it) => (
                    <li class="dive-chip">{it}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
        <p class="mt-6 text-sm leading-relaxed text-cream/70">
          Going deeper on
          {
            especializaciones.map((e, i) => (
              <>
                {i > 0 && (i === especializaciones.length - 1 ? ' and ' : ', ')}
                <a href={e.privado ? pedirAcceso(`${e.tecnologia} track`) : e.repo} class="underline decoration-ice/60 underline-offset-4 hover:text-cream">
                  {e.tecnologia}
                </a>
              </>
            ))
          }
          . Private study repos, ask for access.
        </p>
      </div>
    </section>

    <!-- 5 · Trabajo: Mercatto aparece flotando como objeto -->
    <section class="dive-scene dive-center">
      <p class="dive-phrase" data-phrase>Below the surface, <em>it runs a business.</em></p>
    </section>
    <section id="work" class="dive-scene dive-split dive-split-right">
      <div class="dive-panel" data-panel>
        <p class="dive-kicker">● Live in production</p>
        <h2 class="dive-h2">{estrella?.nombre}</h2>
        <p class="mt-4 leading-relaxed text-cream/80">{estrella?.descripcion}</p>
        <p class="mt-3 font-mono text-xs text-cream/50">{estrella?.tags.join(' · ')}</p>
        <div class="mt-6 flex flex-wrap gap-2">
          {
            estrella?.demo && (
              <a href={estrella.demo} target="_blank" rel="noopener" class="btn btn-primary">
                Open the live app ↗
              </a>
            )
          }
          {
            estrella && (
              <a href={estrella.privado ? pedirAcceso(estrella.nombre) : estrella.repo} class="btn btn-ghost">
                {estrella.privado ? '🔒 Request code access' : 'View code ↗'}
              </a>
            )
          }
        </div>
        <p class="dive-kicker mt-8 !text-cream/60">Also shipped</p>
        <ul class="mt-3 divide-y divide-cream/10 border-y border-cream/10">
          {
            resto.map((p) => (
              <li class="flex items-center gap-3 py-3">
                <div class="min-w-0 flex-1">
                  <p class="font-semibold text-cream">
                    {p.nombre} <span class="ml-1 font-mono text-xs font-normal text-ice">{p.anio}</span>
                  </p>
                  <p class="text-sm leading-snug text-cream/60">{p.descripcion}</p>
                </div>
                <a
                  href={p.privado ? pedirAcceso(p.nombre) : p.repo}
                  target={p.privado ? undefined : '_blank'}
                  rel={p.privado ? undefined : 'noopener'}
                  class="btn btn-ghost shrink-0"
                  aria-label={`${p.privado ? 'Request code access for' : 'View the code of'} ${p.nombre}`}
                >
                  {p.privado ? '🔒' : '↗'}
                </a>
              </li>
            ))
          }
        </ul>
        <p class="mt-3 text-xs leading-relaxed text-cream/45">{motivoPrivado}</p>
      </div>
    </section>

    <!-- 6 · Trayectoria: el año cuenta con el scroll, como la profundidad en la referencia -->
    <section id="journey" class="dive-journey" data-journey>
      <div class="dive-journey-pin" data-journey-pin>
        <p class="dive-kicker text-center">Building since</p>
        <p class="dive-year" data-year>{historia[0].anio}</p>
        <div class="dive-milestones">
          {
            historia.map((t) => (
              <div class="dive-milestone" data-milestone data-anio={t.anio}>
                <p class="font-semibold text-cream">{t.titulo}</p>
                <p class="mt-1 text-sm leading-relaxed text-cream/70">{t.texto}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- 7 · Cierre: de vuelta a la superficie -->
    <section class="dive-scene dive-center">
      <p class="dive-phrase" data-phrase>This page will end.<br /><em>Good software keeps running.</em></p>
    </section>
    <section id="contact" class="dive-scene dive-contact">
      <div class="dive-contact-card" data-panel>
        <img src={asset('foto-real.webp')} alt="Jorge Quintero" width="560" height="560" class="size-20 rounded-full ring-2 ring-cream/40 sm:size-24" />
        <h2 class="dive-h2 mt-5">Let's build <em>what's next.</em></h2>
        <p class="mt-3 text-cream/80">An idea, a product or a team to build with: email is the fastest way to reach me.</p>
        <div class="mt-6 flex flex-wrap justify-center gap-2">
          <a href={`mailto:${perfil.enlaces.email}`} class="btn btn-primary min-h-12 px-6">Email me</a>
          <button type="button" class="btn btn-light min-h-12 px-6" data-copiar={perfil.enlaces.email}>Copy email</button>
        </div>
        <ul class="mt-2 flex flex-wrap justify-center gap-2">
          <li><a href={perfil.enlaces.linkedin} target="_blank" rel="noopener" class="btn btn-ghost">LinkedIn ↗</a></li>
          <li><a href={perfil.enlaces.github} target="_blank" rel="noopener" class="btn btn-ghost">GitHub ↗</a></li>
          <li><a href={perfil.enlaces.upwork} target="_blank" rel="noopener" class="btn btn-ghost">Upwork ↗</a></li>
        </ul>
        <p class="mt-5 font-mono text-xs break-all text-cream/60">{perfil.enlaces.email}</p>
      </div>
      <footer class="dive-footer">
        <span>© {new Date().getFullYear()} {perfil.nombre}</span>
        <a href={`${BASE}profile.json`}>profile.json</a>
        <a href={`${BASE}particles/`}>Particles version</a>
        <a href={`${BASE}old/`}>First version</a>
      </footer>
    </section>
  </main>

  <p class="toast" role="status" aria-live="polite" data-toast></p>

  <script>
    import { iniciarInmersion } from '../lib/dive';
    iniciarInmersion();
  </script>
</Base>

