---
/**
 * Versión "Mundos": el portafolio cuenta una historia y el scroll atraviesa un mundo por cada
 * tecnología (la web, React, TypeScript y Next.js, Java y Spring Boot, la nube y la IA,
 * producción). Entre mundo y mundo se abre un portal. El avatar viaja contigo y al final
 * aparece tu nombre, tu avatar al lado y tu tarjeta con redes.
 * Versiones anteriores: /particles y /old.
 */
import Base from '../layouts/Base.astro';
import '../styles/worlds.css';
import { asset, BASE } from '../lib/base';
import { datosEstructurados, especializaciones, motivoPrivado, pedirAcceso, perfil, proyectos } from '../data/perfil';

const [estrella, ...resto] = proyectos;
const urlSitio = Astro.site ? new URL(BASE, Astro.site).href : BASE;
const jsonLd = JSON.stringify(datosEstructurados(urlSitio));

type Mundo = {
  id: string;
  nombre: string;
  anio: string;
  titulo: string;
  emphasis: string;
  texto: string;
  chips: string[];
  /** Símbolos que flotan en el fondo del mundo */
  simbolos: string[];
};

// Cada mundo es un capítulo de la historia (mismo orden que las capas del escenario)
const mundos: Mundo[] = [
  {
    id: 'web',
    nombre: 'The Web',
    anio: '2019',
    titulo: 'Where it all',
    emphasis: 'began.',
    texto: 'My first lines of code at Cesde: HTML, CSS, JavaScript, PHP and MySQL. Pages that taught me how the web really works.',
    chips: ['HTML5', 'CSS3', 'JavaScript', 'PHP', 'MySQL', 'Bootstrap'],
    simbolos: ['<html>', '</div>', '{ }', '.css', 'function()', '<body>', '#id', ';'],
  },
  {
    id: 'react',
    nombre: 'React',
    anio: '2021',
    titulo: 'Thinking in',
    emphasis: 'components.',
    texto: 'Academia Geek bootcamp: React, Redux and Firebase in team sprints. Then my first developer job, where I grew for four years.',
    chips: ['React', 'Redux', 'Firebase', 'Hooks', 'Design Thinking'],
    simbolos: ['<App />', 'useState', '<Card />', 'props', 'useEffect', '<Nav />', 'JSX'],
  },
  {
    id: 'typescript',
    nombre: 'TypeScript & Next.js',
    anio: '2023',
    titulo: 'Making it',
    emphasis: 'solid.',
    texto: 'Type-safe from front to back, server rendering and API routes: products that are fast, easy to find and hard to break.',
    chips: ['TypeScript', 'Next.js', 'SSR & SSG', 'Tailwind CSS', 'Astro'],
    simbolos: [': string', 'interface', 'type', '<T>', 'app/', 'async', 'export'],
  },
  {
    id: 'backend',
    nombre: 'Java & Spring Boot',
    anio: '2025',
    titulo: 'Where the business',
    emphasis: 'logic lives.',
    texto: 'APIs and integrations that scale, built with Java, Spring Boot and Node.js, in fintech teams alongside QA, product and business.',
    chips: ['Java', 'Spring Boot', 'Node.js', 'REST APIs', 'SQL'],
    simbolos: ['GET /sales 200', 'POST /orders 201', '@RestController', '@Service', 'PUT /users 200', 'JWT'],
  },
  {
    id: 'cloud',
    nombre: 'Cloud & AI',
    anio: '2026',
    titulo: 'Deployed, and now',
    emphasis: 'intelligent.',
    texto: 'Google Cloud, Vertex AI and AI agents. Today I work as a Forward Deployed Engineer: close to the business, turning real needs into software.',
    chips: ['Google Cloud', 'Vertex AI', 'AI agents', 'Cloud Functions', 'Fintech'],
    simbolos: ['agent.run()', 'gcloud deploy', 'vertex.ai', 'prompt', 'embeddings', 'Cloud Run'],
  },
];

const redes = [
  { texto: 'LinkedIn', url: perfil.enlaces.linkedin, detalle: '/in/jorgeadj' },
  { texto: 'GitHub', url: perfil.enlaces.github, detalle: '@jorgejj2018' },
  { texto: 'Upwork', url: perfil.enlaces.upwork, detalle: 'Hire me' },
  { texto: 'X', url: perfil.enlaces.x, detalle: '@jorge_adj' },
];

const poses = [
  { id: 'hero', src: asset('avatar/hero.webp'), w: 587, h: 1083 },
  { id: 'tres', src: asset('avatar/perfil-tres-cuartos.webp'), w: 187, h: 362 },
  { id: 'lado', src: asset('avatar/perfil-lado.webp'), w: 132, h: 363 },
  { id: 'arriba', src: asset('avatar/busto-mirando-arriba.webp'), w: 265, h: 401 },
  { id: 'sonrisa', src: asset('avatar/busto-sonrisa.webp'), w: 241, h: 403 },
];

// Índice de capítulos: origen, cinco mundos, producción y final
const capitulos = [{ id: 'origin', nombre: 'Origin' }, ...mundos.map((m) => ({ id: m.id, nombre: m.nombre })), { id: 'production', nombre: 'Production' }, { id: 'me', nombre: 'Jorge' }];
---

<Base title={`${perfil.nombre} · ${perfil.rol}`} description={`${perfil.nombre}, ${perfil.rol.toLowerCase()} in ${perfil.ubicacion}. ${perfil.lema}`}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={jsonLd} />
    <link rel="alternate" type="application/json" href={`${BASE}profile.json`} title="Machine-readable profile" />
    <link rel="alternate" type="text/plain" href={`${BASE}llms.txt`} title="Profile for AI assistants" />
  </Fragment>

  <!-- Escenario fijo: una capa por mundo; cada una se abre como un portal sobre la anterior -->
  <div class="w-stage" aria-hidden="true">
    <div class="w-world w-origin" data-world>
      <div class="w-stars"></div>
    </div>
    {
      mundos.map((m) => (
        <div class:list={['w-world', `w-${m.id}`]} data-world>
          <div class="w-deco" />
          <div class="w-symbols">
            {m.simbolos.map((s, i) => (
              <span class="w-symbol" style={`--i:${i}`}>
                {s}
              </span>
            ))}
          </div>
          <p class="w-watermark">{m.anio}</p>
        </div>
      ))
    }
    <div class="w-world w-production" data-world>
      <div class="w-deco"></div>
      <img src={asset('mercatto.webp')} alt="" width="960" height="600" class="w-screen" data-screen />
    </div>
    <div class="w-world w-me" data-world>
      <div class="w-stars"></div>
    </div>
    <div class="w-ring" data-ring></div>

    <!-- El avatar que viaja por los mundos -->
    <div class="w-avatar" data-avatar>
      {poses.map((p, i) => <img src={p.src} alt="" width={p.w} height={p.h} class="w-pose" data-pose={p.id} style={i === 0 ? '' : 'opacity:0'} draggable="false" />)}
    </div>
  </div>

  <!-- Encabezado -->
  <header class="w-header">
    <nav class="w-gutter flex h-16 items-center justify-between gap-3" aria-label="Main">
      <a href="#origin" class="flex min-h-11 shrink-0 items-center gap-2.5 text-cream">
        <span class="grid size-9 place-items-center rounded-lg bg-cream text-sm font-extrabold text-shirt">JQ</span>
        <span class="hidden text-sm font-semibold sm:inline">Jorge Quintero</span>
      </a>
      <p class="w-now" aria-live="polite"><span data-now-num>01</span>/{String(capitulos.length).padStart(2, '0')} · <span data-now>Origin</span></p>
      <a href="#me" class="btn btn-primary shrink-0">Contact</a>
    </nav>
    <div class="h-0.5 origin-left bg-accent" style="transform:scaleX(0)" data-progress></div>
  </header>

  <!-- Índice lateral (escritorio) -->
  <nav class="w-index" aria-label="Worlds">
    <ol>
      {
        capitulos.map((c) => (
          <li>
            <a href={`#${c.id}`} data-index={c.id}>
              <span>{c.nombre}</span>
              <i />
            </a>
          </li>
        ))
      }
    </ol>
  </nav>

  <main class="relative z-10 overflow-x-clip">
    <!-- Origen -->
    <section id="origin" class="w-scene w-scene-intro" data-chapter="Origin">
      <div class="w-intro">
        <p class="w-kicker">A story in seven worlds</p>
        <h1 class="w-intro-title" data-split>Every product starts as <em>an idea.</em></h1>
        <p class="w-intro-sub">This is the story of the engineer who turns them into software. Scroll to travel through the worlds he has built in.</p>
        <p class="w-scroll"><span></span> Scroll to travel</p>
      </div>
    </section>

    {
      mundos.map((m, i) => (
        <section id={m.id} class:list={['w-scene', i % 2 ? 'w-right' : 'w-left']} data-chapter={m.nombre}>
          <article class="w-card" data-card>
            <p class="w-kicker">
              World {String(i + 1).padStart(2, '0')} · {m.nombre} <span class="text-cream/50">· {m.anio}</span>
            </p>
            <h2 class="w-h2" data-split>
              {m.titulo} <em>{m.emphasis}</em>
            </h2>
            <p class="w-text">{m.texto}</p>
            <ul class="w-chips">
              {m.chips.map((c) => (
                <li>{c}</li>
              ))}
            </ul>
            {m.id === 'typescript' && (
              <p class="mt-5 text-sm text-cream/70">
                Going deeper in private study repos:{' '}
                {especializaciones.map((e, k) => (
                  <>
                    {k > 0 && ' · '}
                    <a href={e.privado ? pedirAcceso(`${e.tecnologia} track`) : e.repo} class="underline decoration-ice/60 underline-offset-4 hover:text-cream">
                      {e.tecnologia}
                    </a>
                  </>
                ))}
              </p>
            )}
          </article>
        </section>
      ))
    }

    <!-- Producción: lo que se construyó con todo lo anterior -->
    <section id="production" class="w-scene w-right" data-chapter="Production">
      <article class="w-card" data-card>
        <p class="w-kicker"><span class="text-emerald-400">●</span> World 06 · Production · now</p>
        <h2 class="w-h2" data-split>All of it, <em>live.</em></h2>
        <p class="w-text">
          <strong class="text-cream">{estrella?.nombre}</strong>: {estrella?.descripcion}
        </p>
        <div class="mt-5 flex flex-wrap gap-2">
          {
            estrella?.demo && (
              <a href={estrella.demo} target="_blank" rel="noopener" class="btn btn-primary">
                Open the live app ↗
              </a>
            )
          }
          {
            estrella && (
              <a href={estrella.privado ? pedirAcceso(estrella.nombre) : estrella.repo} class="btn btn-ghost">
                {estrella.privado ? '🔒 Request code access' : 'View code ↗'}
              </a>
            )
          }
        </div>
        <p class="w-kicker mt-7 !text-cream/55">Also shipped</p>
        <ul class="mt-2 divide-y divide-cream/10 border-y border-cream/10">
          {
            resto.map((p) => (
              <li class="flex items-center gap-3 py-2.5">
                <div class="min-w-0 flex-1">
                  <p class="font-semibold text-cream">
                    {p.nombre} <span class="ml-1 font-mono text-xs font-normal text-ice">{p.anio}</span>
                  </p>
                  <p class="text-sm leading-snug text-cream/60">{p.descripcion}</p>
                </div>
                <a
                  href={p.privado ? pedirAcceso(p.nombre) : p.repo}
                  target={p.privado ? undefined : '_blank'}
                  rel={p.privado ? undefined : 'noopener'}
                  class="btn btn-ghost shrink-0"
                  aria-label={`${p.privado ? 'Request code access for' : 'View the code of'} ${p.nombre}`}
                >
                  {p.privado ? '🔒' : '↗'}
                </a>
              </li>
            ))
          }
        </ul>
        <p class="mt-3 text-xs leading-relaxed text-cream/45">{motivoPrivado}</p>
      </article>
    </section>

    <!-- Final: la historia se cierra con mi nombre, mi avatar al lado y mi tarjeta -->
    <section id="me" class="w-scene w-finale" data-chapter="Jorge">
      <div class="w-finale-grid">
        <div class="w-finale-name">
          <p class="w-kicker">The engineer behind the story</p>
          <h2 class="w-name" data-name>Jorge<br /><em>Quintero.</em></h2>
        </div>
        <img src={asset('avatar/hero.webp')} alt="3D avatar of Jorge Quintero with arms crossed" width="587" height="1083" class="w-finale-avatar" data-finale-avatar />
        <div class="w-contact-card" data-contact-card>
          <div class="flex items-center gap-4">
            <img src={asset('foto-real.webp')} alt="" width="560" height="560" class="size-16 shrink-0 rounded-full ring-2 ring-accent/60" />
            <div class="min-w-0">
              <p class="font-display text-[1.9rem] leading-none text-cream">{perfil.nombre}</p>
              <p class="mt-1 text-sm text-cream/70">Forward Deployed Engineer · Fintech</p>
              <p class="text-sm text-cream/50">{perfil.ubicacion}</p>
            </div>
          </div>
          <div class="mt-5 flex flex-wrap gap-2">
            <a href={`mailto:${perfil.enlaces.email}`} class="btn btn-primary flex-1">Email me</a>
            <button type="button" class="btn btn-light flex-1" data-copiar={perfil.enlaces.email}>Copy email</button>
          </div>
          <ul class="mt-4 grid grid-cols-2 gap-2">
            {
              redes.map((r) => (
                <li>
                  <a href={r.url} target="_blank" rel="noopener" class="w-social">
                    <span class="font-semibold text-cream">{r.texto} ↗</span>
                    <span class="truncate font-mono text-[0.7rem] text-cream/55">{r.detalle}</span>
                  </a>
                </li>
              ))
            }
          </ul>
          <p class="mt-4 font-mono text-xs break-all text-cream/55">{perfil.enlaces.email}</p>
        </div>
      </div>
      <footer class="w-footer">
        <span>© {new Date().getFullYear()} {perfil.nombre} · The story continues.</span>
        <a href={`${BASE}profile.json`}>profile.json</a>
        <a href={`${BASE}particles/`}>Particles version</a>
        <a href={`${BASE}old/`}>First version</a>
      </footer>
    </section>
  </main>

  <p class="toast" role="status" aria-live="polite" data-toast></p>

  <script>
    import { iniciarMundos } from '../lib/worlds';
    iniciarMundos();
  </script>
</Base>
