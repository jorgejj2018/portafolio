---
import AvatarPose from '../ui/AvatarPose.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { perfil } from '../../data/perfil';

// Mis datos como el objeto final que devuelve el build; cada valor es un enlace
const datos = [
  { clave: 'role', valor: perfil.rol },
  { clave: 'based', valor: perfil.ubicacion },
  { clave: 'email', valor: perfil.enlaces.email, url: `mailto:${perfil.enlaces.email}` },
  { clave: 'upwork', valor: 'Hire me on Upwork', url: perfil.enlaces.upwork },
  { clave: 'linkedin', valor: '/in/jorgeadj', url: perfil.enlaces.linkedin },
  { clave: 'github', valor: '@jorgejj2018', url: perfil.enlaces.github },
  { clave: 'x', valor: '@jorge_adj', url: perfil.enlaces.x },
  { clave: 'status', valor: 'open to work', estado: true },
];

// La palabra final se completa letra por letra con el scroll
const palabraFinal = ['JORGE', 'QUINTERO'];
---

<section id="contact" data-station="6" class="flex flex-col justify-center pt-10 pb-16">
  <div class="max-w-2xl">
    <SectionHeading etiqueta="Contact">Have a project in mind? Let's talk.</SectionHeading>
    <p class="mt-6 text-lg leading-relaxed text-cream-dim" data-reveal>
      I am open to full-time roles, freelance projects and collaborations. The build is done; the next one can be yours.
    </p>
  </div>

  <!-- Cierre: el build termina, la palabra final se completa y aparecen mis datos -->
  <div class="mt-16 grid items-center gap-10 lg:grid-cols-[0.42fr_1fr] lg:gap-14" data-final>
    <AvatarPose pose="hero" alt="3D avatar of Jorge Quintero with arms crossed" width={587} height={1083} class="mx-auto w-full max-w-[13rem] lg:max-w-[17rem]" parallax={0} />
    <div class="min-w-0">
      <p class="font-mono text-xs text-emerald-400" data-final-done>✓ build complete · deployed to production</p>
      <p
        class="final-word mt-4 font-display text-[clamp(3.2rem,11.5vw,8.6rem)] leading-[0.86] font-extrabold tracking-[-0.045em]"
        aria-label={palabraFinal.join(' ')}
        data-final-word
      >
        {
          palabraFinal.map((w, i) => (
            <span class="block whitespace-nowrap" aria-hidden="true">
              {w.split('').map((c) => <span class="final-char" data-char={c}>{c}</span>)}
              {i === palabraFinal.length - 1 && <span class="final-char text-accent" data-char=".">.</span>}
            </span>
          ))
        }
      </p>
      <dl class="mt-10 rounded-2xl border border-cream/10 bg-shirt-2/80 p-5 font-mono text-[0.78rem] leading-relaxed backdrop-blur sm:p-6 sm:text-sm" data-final-data>
        <p class="text-cream/40" data-final-row>{'export default {'}</p>
        {
          datos.map((d) => (
            <div class="flex min-w-0 gap-2 pl-4" data-final-row>
              <dt class="shrink-0 text-ice">{d.clave}:</dt>
              <dd class="min-w-0 truncate">
                {d.url ? (
                  <a
                    href={d.url}
                    target={d.url.startsWith('mailto:') ? undefined : '_blank'}
                    rel="noopener"
                    class="text-[#f2c48d] underline decoration-cream/20 underline-offset-4 transition-colors hover:text-cream hover:decoration-accent"
                  >
                    '{d.valor}'
                  </a>
                ) : d.estado ? (
                  <span class="text-emerald-400">
                    '{d.valor}' <span class="inline-block size-1.5 animate-pulse rounded-full bg-emerald-400 align-middle" />
                  </span>
                ) : (
                  <span class="text-[#f2c48d]">'{d.valor}'</span>
                )}
                <span class="text-cream/40">,</span>
              </dd>
            </div>
          ))
        }
        <p class="text-cream/40" data-final-row>{'};'}</p>
      </dl>
    </div>
  </div>

  <footer class="mt-20 border-t border-cream/10 pt-6 pb-[env(safe-area-inset-bottom)] text-center font-mono text-xs text-cream/50">
    © {new Date().getFullYear()} {perfil.nombre} · {perfil.ubicacion}
  </footer>
</section>
