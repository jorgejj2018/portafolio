---
import AvatarPose from '../ui/AvatarPose.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { perfil } from '../../data/perfil';

// Mis datos como el objeto final que devuelve el build (solo lectura)
const datos = [
  { clave: 'role', valor: perfil.rol },
  { clave: 'based', valor: perfil.ubicacion },
  { clave: 'email', valor: perfil.enlaces.email },
  { clave: 'reply', valor: 'usually within a day' },
];

// Los botones de contacto van aparte y se ven como botones, para que quede claro dónde tocar
const botones = [
  { texto: 'Email me', url: `mailto:${perfil.enlaces.email}`, clase: 'btn-primary', icono: 'mail' },
  { texto: 'Upwork', url: perfil.enlaces.upwork, clase: 'btn-light', icono: 'upwork' },
  { texto: 'LinkedIn', url: perfil.enlaces.linkedin, clase: 'btn-ghost', icono: 'in' },
  { texto: 'GitHub', url: perfil.enlaces.github, clase: 'btn-ghost', icono: 'gh' },
  { texto: 'X', url: perfil.enlaces.x, clase: 'btn-ghost', icono: 'x' },
];

// La palabra final se completa letra por letra con el scroll
const palabraFinal = ['JORGE', 'QUINTERO'];
---

<section id="contact" data-station="6" class="flex flex-col justify-center pt-10 pb-16">
  <div class="max-w-2xl">
    <SectionHeading etiqueta="Contact">Have a project in mind? Let's talk.</SectionHeading>
    <p class="mt-6 text-lg leading-relaxed text-cream-dim" data-reveal>
      If you have an idea, a product or a team where my work can help, write to me. The build is done; the next one can be ours.
    </p>
  </div>

  <!-- Cierre: el build termina, la palabra final se completa y aparecen mis datos -->
  <div class="mt-12 grid items-center gap-8 md:grid-cols-[0.38fr_1fr] md:gap-10 lg:mt-16 lg:grid-cols-[0.42fr_1fr] lg:gap-14" data-final>
    <AvatarPose pose="hero" alt="3D avatar of Jorge Quintero with arms crossed" width={587} height={1083} class="mx-auto w-full max-w-[9rem] sm:max-w-[11rem] md:max-w-[13rem] lg:max-w-[17rem]" parallax={0} />
    <div class="min-w-0">
      <p class="font-mono text-xs text-emerald-400" data-final-done>✓ build complete · deployed to production</p>
      <p
        class="final-word mt-4 font-display text-[clamp(3rem,14.5vw,5rem)] md:text-[clamp(3rem,8vw,8.6rem)] leading-[0.86] font-extrabold tracking-[-0.045em]"
        aria-label={palabraFinal.join(' ')}
        data-final-word
      >
        {
          palabraFinal.map((w, i) => (
            <span class="block whitespace-nowrap" aria-hidden="true">
              {w.split('').map((c) => <span class="final-char" data-char={c}>{c}</span>)}
              {i === palabraFinal.length - 1 && <span class="final-char text-accent" data-char=".">.</span>}
            </span>
          ))
        }
      </p>
      <!-- Botones de contacto: lo primero que se puede tocar al terminar el recorrido -->
      <div class="mt-8" data-final-row>
        <p class="font-mono text-xs text-cream/50">Tap to get in touch ↓</p>
        <div class="mt-3 flex flex-wrap gap-2.5">
          {
            botones.map((b) => (
              <a
                href={b.url}
                target={b.url.startsWith('mailto:') ? undefined : '_blank'}
                rel="noopener"
                class:list={['btn', b.clase, b.icono === 'mail' || b.icono === 'upwork' ? 'min-h-12 px-5 text-[0.95rem]' : '']}
              >
                {b.icono === 'mail' && (
                  <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <rect x="3" y="5" width="18" height="14" rx="2" />
                    <path d="m3 7 9 6 9-6" />
                  </svg>
                )}
                {b.texto}
                {b.icono !== 'mail' && <span aria-hidden="true">↗</span>}
              </a>
            ))
          }
        </div>
      </div>
      <dl class="mt-8 rounded-2xl border border-cream/10 bg-shirt-2/80 p-5 font-mono text-[0.75rem] leading-relaxed backdrop-blur sm:p-6 sm:text-sm" data-final-data>
        <p class="text-cream/40" data-final-row>{'export default {'}</p>
        {
          datos.map((d) => (
            <div class="flex min-w-0 gap-2 pl-4" data-final-row>
              <dt class="shrink-0 text-ice">{d.clave}:</dt>
              <dd class="min-w-0 truncate text-[#f2c48d]">
                '{d.valor}'
                <span class="text-cream/40">,</span>
              </dd>
            </div>
          ))
        }
        <p class="text-cream/40" data-final-row>{'};'}</p>
      </dl>
    </div>
  </div>

  <footer class="mt-20 border-t border-cream/10 pt-6 pb-[env(safe-area-inset-bottom)] text-center font-mono text-xs text-cream/50">
    © {new Date().getFullYear()} {perfil.nombre} · {perfil.ubicacion}
  </footer>
</section>
