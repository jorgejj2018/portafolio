---
import AvatarPose from '../ui/AvatarPose.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { trayectoria } from '../../data/perfil';

// Al bajar viajamos hacia atrás en el tiempo: lo más reciente arriba
const historia = [...trayectoria].reverse();
---

<section id="journey" data-station="5" class="grid items-center gap-12 py-12 lg:grid-cols-[1.45fr_0.55fr]">
  <div>
    <SectionHeading nivel={6} etiqueta="Journey" class="max-w-2xl">The further you scroll, the further back in time.</SectionHeading>
    <ol class="relative mt-12 max-w-3xl" data-timeline>
      <span class="absolute top-0 bottom-0 left-0 w-px bg-cream/10 sm:left-[7rem]" aria-hidden="true"></span>
      <span class="absolute top-0 bottom-0 left-0 w-px origin-top bg-accent sm:left-[7rem]" style="transform:scaleY(0)" data-timeline-line aria-hidden="true"></span>
      {
        historia.map((t, i) => (
          <li class="relative grid gap-1 py-6 pl-6 sm:grid-cols-[7rem_1fr] sm:gap-8 sm:pl-0" data-timeline-item>
            <span class="absolute top-8 left-[-4px] size-[9px] rounded-full border border-accent bg-shirt sm:left-[calc(7rem-4px)]" data-timeline-dot aria-hidden="true" />
            <span class:list={['font-mono text-sm tabular-nums sm:pt-1', i === 0 ? 'text-accent' : 'text-ice']}>{t.anio}</span>
            <div class="sm:pl-8">
              <h3 class="font-display text-xl font-bold text-cream">{t.titulo}</h3>
              <p class="mt-1.5 leading-relaxed text-cream-dim">{t.texto}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
  <!-- Mirando hacia arriba, hacia lo más reciente -->
  <AvatarPose
    pose="busto-mirando-arriba"
    alt="Jorge's avatar looking up"
    width={265}
    height={401}
    class="mx-auto hidden w-full max-w-[13rem] lg:block lg:self-end"
  />
</section>
