---
import AvatarPose from '../ui/AvatarPose.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { stack } from '../../data/perfil';
---

<section id="stack" data-station="2" class="flex flex-col justify-center py-12">
  <SectionHeading etiqueta="Stack" class="max-w-2xl">The tools I use to build.</SectionHeading>
  <div class="mt-12 grid items-end gap-4 md:grid-cols-3 lg:grid-cols-[0.45fr_1fr_1fr_1fr]" data-stagger>
    <!-- De perfil, mirando hacia las tarjetas -->
    <AvatarPose pose="perfil-lado" alt="Jorge's avatar in profile" width={132} height={363} class="mx-auto hidden w-32 lg:block" parallax={0.05} />
    <div class="contents">
    {
      stack.map((g) => (
        <div class="panel backlit rounded-2xl p-6" data-stagger-item>
          <h3 class="font-mono text-xs tracking-[0.14em] text-ice uppercase">{g.grupo}</h3>
          <ul class="mt-5 grid grid-cols-2 gap-x-4 gap-y-2.5 md:grid-cols-1">
            {g.items.map((i) => (
              <li class="flex items-center gap-3 text-cream">
                <span class="size-1 shrink-0 rounded-full bg-accent" />
                {i}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
    </div>
  </div>
</section>
