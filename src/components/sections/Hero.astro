---
import Counter from '../react/Counter';
import { perfil, roles, sobreMi } from '../../data/perfil';
import { asset } from '../../lib/base';

// Código de la portada con resaltado; cada línea se escribe sola al cargar
const k = (t: string) => `<span class="tok-kw">${t}</span>`;
const st = (t: string) => `<span class="tok-str">'${t}'</span>`;
const fn = (t: string) => `<span class="tok-fn">${t}</span>`;
const prop = (t: string) => `<span class="tok-prop">${t}</span>`;
const codigo = [
  `${k('import')} { Developer } ${k('from')} ${st('@jorge/core')};`,
  '',
  `${k('const')} jorge = ${k('new')} ${fn('Developer')}({`,
  `  ${prop('role')}: ${st('Forward Deployed Engineer')},`,
  `  ${prop('stack')}: [${st('React')}, ${st('Next.js')}, ${st('Spring Boot')}],`,
  `  ${prop('based')}: ${st('Medellín, CO')},`,
  '});',
  '',
  `${k('await')} jorge.${fn('build')}(yourIdea); <span class="tok-com">// → software that ships</span>`,
];
---

<section id="home" data-station="0" class="relative grid min-h-svh items-center gap-8 pt-28 pb-16 lg:grid-cols-[1.05fr_0.95fr] lg:gap-14" data-hero>
  <div class="order-2 lg:order-1" data-hero-copy>
    <p class="eyebrow flex flex-wrap items-center gap-x-3 gap-y-1" data-hero-item>
      <span class="h-px w-8 bg-accent" aria-hidden="true"></span>
      <span class="text-cream" data-roles={JSON.stringify(roles)} aria-live="off">{roles[0]}</span>
      <span class="text-cream/40">/</span>
      <span>{perfil.ubicacion}</span>
    </p>
    <h1
      class="mt-5 font-display text-[clamp(3.1rem,10vw,6.5rem)] leading-[0.92] font-extrabold tracking-[-0.03em] text-cream"
      data-hero-title
    >
      Jorge<br />Quintero<span class="text-accent">.</span>
    </h1>
    <p class="mt-7 max-w-xl text-lg leading-relaxed text-cream-dim" data-hero-item>
      I turn your idea into software that drives your business. Software, APIs and integrations that scale with{' '}
      <span class="text-cream">React</span>, <span class="text-cream">Next.js</span>, <span class="text-cream">Spring Boot</span>,{' '}
      <span class="text-cream">GCP</span>{' and '}<span class="text-cream">AI agents</span>. Creator of <a href="#projects" class="text-cream underline decoration-accent decoration-2 underline-offset-4 hover:text-ice">Mercatto SaaS</a>.
    </p>
    <div class="mt-9 flex flex-wrap items-center gap-3" data-hero-item>
      <a href="#projects" data-magnetic class="inline-flex min-h-12 items-center rounded-full bg-cream px-6 font-semibold text-shirt transition hover:bg-white">
        See projects
      </a>
      <a
        href={perfil.enlaces.github}
        target="_blank"
        rel="noopener"
        data-magnetic
        class="inline-flex min-h-12 items-center rounded-full border border-cream/20 px-6 font-semibold text-cream transition hover:border-cream/50"
      >
        GitHub ↗
      </a>
    </div>
    <dl class="mt-12 grid max-w-lg grid-cols-3 gap-4 border-t border-cream/10 pt-6 sm:gap-6" data-hero-item>
      {
        sobreMi.datos.map((d) => (
          <div>
            <dt class="sr-only">{d.etiqueta}</dt>
            <dd class="font-display text-[clamp(1.6rem,5vw,1.9rem)] font-bold text-cream">
              <Counter client:visible valor={d.valor} sufijo={d.sufijo} />
            </dd>
            <dd class="mt-1 text-xs leading-snug text-cream-dim">{d.etiqueta}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <!-- El código se escribe, "compila" y sus partículas suben a formar la foto real: el producto terminado -->
  <div class="relative order-1 mx-auto w-full max-w-[22rem] sm:max-w-[26rem] lg:order-2 lg:max-w-none" data-hero-avatar>
    <div class="relative mx-auto aspect-square w-[11rem] sm:w-[14rem] lg:w-[17rem]">
      <div class="avatar-glow pointer-events-none absolute inset-[-30%]" data-pose-glow></div>
      <div class="photo-ring absolute inset-[-6px] rounded-full" aria-hidden="true"></div>
      <img
        src={asset('foto-real.webp')}
        alt="Jorge Quintero"
        width="560"
        height="560"
        loading="eager"
        decoding="async"
        class="relative size-full rounded-full object-cover opacity-0 transition-opacity duration-500"
        data-hero-photo
      />
      <p
        class="absolute right-[-14%] bottom-[8%] rounded-full border border-cream/15 bg-shirt/85 px-3 py-1.5 font-mono text-[0.7rem] whitespace-nowrap text-cream opacity-0 backdrop-blur sm:text-xs"
        data-hero-badge
      >
        <span class="mr-1.5 inline-block size-1.5 animate-pulse rounded-full bg-emerald-400 align-middle"></span>Open to work
      </p>
    </div>

    <div class="code-window relative z-10 mt-6 overflow-hidden rounded-2xl border border-cream/10 bg-shirt-2/90 font-mono text-[0.66rem] leading-[1.75] shadow-2xl shadow-black/40 backdrop-blur sm:text-xs" data-hero-code>
      <div class="flex items-center gap-2 border-b border-cream/10 px-4 py-2.5">
        <span class="size-2.5 rounded-full bg-[#ff5f57]"></span><span class="size-2.5 rounded-full bg-[#febc2e]"></span><span class="size-2.5 rounded-full bg-[#28c840]"></span>
        <span class="ml-2 text-cream/50">jorge.ts</span>
      </div>
      <ol class="overflow-hidden px-4 py-3 whitespace-pre text-cream">
        {
          codigo.map((linea, i) => (
            <li class="flex gap-4">
              <span class="w-4 shrink-0 text-right text-cream/25 select-none">{i + 1}</span>
              <span class="inline-block" data-code-line style="clip-path:inset(0 100% 0 0)" set:html={linea || ' '} />
            </li>
          ))
        }
      </ol>
      <p class="flex items-center gap-2 border-t border-cream/10 px-4 py-2 text-cream/60" data-code-status>
        <span class="inline-block size-1.5 rounded-full bg-amber-400" data-code-dot></span><span data-code-msg>compiling…</span>
      </p>
    </div>
    <canvas class="pointer-events-none absolute inset-[-12%] z-20 h-[124%] w-[124%]" data-hero-canvas aria-hidden="true"></canvas>
  </div>

  <a href="#about" class="order-3 col-span-full hidden items-center gap-3 font-mono text-xs tracking-[0.14em] text-cream-dim uppercase lg:flex" data-hero-item>
    <span class="h-px w-10 bg-cream/30"></span> Scroll to explore ↓
  </a>
</section>
