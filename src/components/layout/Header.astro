---
import MobileMenu from '../react/MobileMenu';
import { niveles } from '../../data/perfil';
---

<header
  class="fixed inset-x-0 top-0 z-40 border-b border-cream/5 bg-shirt/75 pt-[env(safe-area-inset-top)] backdrop-blur-md"
  data-header
>
  <nav class="gutter mx-auto flex h-16 max-w-7xl items-center justify-between gap-4" aria-label="Main">
    <a href="#home" class="flex min-h-11 items-center gap-3">
      <span class="grid size-9 place-items-center rounded-lg bg-cream font-display text-sm font-extrabold text-shirt">JQ</span>
      <span class="font-display text-[0.95rem] font-bold tracking-tight text-cream">Jorge Quintero</span>
    </a>
    <ul class="hidden items-center gap-7 text-sm lg:flex">
      {
        niveles.slice(1).map((n) => (
          <li>
            <a href={`#${n.id}`} data-nav={n.id} class="nav-link relative py-2 text-cream-dim transition-colors hover:text-cream aria-[current=true]:text-cream">
              {n.nombre}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="flex items-center gap-2">
      <a
        href="#contact"
        data-magnetic
        class="hidden min-h-11 items-center rounded-full bg-accent px-5 text-sm font-semibold text-white transition hover:bg-accent-deep sm:inline-flex"
      >
        Let's talk
      </a>
      <MobileMenu client:media="(max-width: 1023px)" niveles={niveles} />
    </div>
  </nav>
</header>
